---
import Base from "../layouts/Base.astro";
import { toolBySlug } from "../lib/tools";

const tool = toolBySlug("image-to-pdf")!;
const FAQ = tool.faq;
const faqLd = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: FAQ.map((f) => ({
		"@type": "Question",
		name: f.q,
		aacceptedAnswer: { "@type": "Answer", text: f.a },
	})),
};
---

<Base title={tool.title} description={tool.description} jsonLd={faqLd}>
	<span class="badge">本地生成 · 不上传</span>
	<h1>图片转 PDF</h1>
	<p class="lead">
		把多张图片合并成一个 PDF：可调整顺序、选择页面尺寸与边距。
		PDF 由浏览器里的 pdf-lib 直接生成，图片与成品都<b>不离开你的设备</b>，适合证件、扫描件、合同这类敏感材料。
	</p>

	<div class="card">
		<div class="dropzone" id="dz">点击选择图片，或把图片拖到这里（可多选，顺序即页序）</div>
		<input id="file" type="file" accept="image/*" multiple hidden />
		<div class="row">
			<label class="field">页面尺寸
				<select id="size">
					<option value="auto">跟随图片（不留白边）</option>
					<option value="a4">A4</option>
					<option value="letter">Letter</option>
				</select>
			</label>
			<label class="field">页边距（pt）
				<input id="margin" type="number" min="0" max="72" step="2" value="0" />
			</label>
			<label class="field">文件名
				<input id="fname" type="text" value="merged" />
			</label>
			<button id="run" disabled>生成 PDF</button>
		</div>
	</div>

	<ul class="results" id="results"></ul>

	<div class="ad-slot" data-ad-slot="tool-mid"></div>

	<h2>怎么用（三步）</h2>
	<ol>
		<li>选中或拖入图片。列表顺序就是 PDF 的页序，可用 ↑ ↓ 调整。</li>
		<li>页面尺寸建议保持「跟随图片」：横图生成横向页、竖图生成纵向页，不会有白边。</li>
		<li>点「生成 PDF」，完成后下载。整个过程离线可用。</li>
	</ol>

	<h2>常见问题</h2>
	{FAQ.map((f) => (
		<details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>
	))}
</Base>

<script>
	import { bindDropZone, formatBytes, loadImage } from "../lib/imgtools.client";

	const dz = document.getElementById("dz")!;
	const input = document.getElementById("file") as HTMLInputElement;
	const runBtn = document.getElementById("run") as HTMLButtonElement;
	const results = document.getElementById("results")!;
	const sizeSel = document.getElementById("size") as HTMLSelectElement;
	const marginIn = document.getElementById("margin") as HTMLInputElement;
	const fnameIn = document.getElementById("fname") as HTMLInputElement;

	let files: File[] = [];

	function render() {
	runBtn.disabled = files.length === 0;
	results.innerHTML = "";
	files.forEach((file, i) => {
		const li = document.createElement("li");
		li.innerHTML = `<span class="name">${i + 1}. ${file.name}</span>
			<span class="size">${formatBytes(file.size)}</span>`;
		const up = document.createElement("button");
		up.textContent = "↑";
		up.className = "ghost";
		up.disabled = i === 0;
		up.addEventListener("click", () => {
			[files[i - 1], files[i]] = [files[i], files[i - 1]];
			render();
		});
		const down = document.createElement("button");
		down.textContent = "↓";
		down.className = "ghost";
		down.disabled = i === files.length - 1;
		down.addEventListener("click", () => {
			[files[i + 1], files[i]] = [files[i], files[i + 1]];
			render();
		});
		const del = document.createElement("button");
		del.textContent = "移除";
		del.className = "ghost";
		del.addEventListener("click", () => {
			files.splice(i, 1);
			render();
		});
		li.append(up, down, del);
		results.appendChild(li);
	});
}

	bindDropZone(dz, input, (picked) => {
		files = files.concat(picked.filter((f) => f.type.startsWith("image/")));
		dz.textContent = files.length ? `已加入 ${files.length} 张，点击可继续添加` : "点击选择图片，或把图片拖到这里（可多选）";
		render();
	});

	runBtn.addEventListener("click", async () => {
	runBtn.disabled = true;
	const status = document.createElement("p");
	status.className = "hint";
	status.textContent = "正在生成…";
	results.after(status);
	try {
		// 按需加载 pdf-lib（约 400KB），只有真正点「生成 PDF」时才下载
		const { PDFDocument } = await import("pdf-lib");
		const pdf = await PDFDocument.create();
		const margin = Math.max(0, Number(marginIn.value || 0));
		const mode = sizeSel.value; // auto | a4 | letter
		const PAGE: Record<string, [number, number]> = { a4: [595.28, 841.89], letter: [612, 792] };
		for (const file of files) {
			const img = await loadImage(file);
			const bytes = new Uint8Array(await file.arrayBuffer());
			let embedded;
			try {
				embedded = file.type === "image/png" ? await pdf.embedPng(bytes) : await pdf.embedJpg(bytes);
			} catch {
				// WebP 等 pdf-lib 不直接支持的格式：先经 canvas 转成 PNG 再嵌入
				const canvas = document.createElement("canvas");
				canvas.width = img.width;
				canvas.height = img.height;
				canvas.getContext("2d")!.drawImage(img.bitmap, 0, 0);
				const pngBlob: Blob = await new Promise((res) => canvas.toBlob((b) => res(b!), "image/png"));
				embedded = await pdf.embedPng(new Uint8Array(await pngBlob.arrayBuffer()));
			}
			let pageW: number;
			let pageH: number;
			if (mode === "auto") {
				pageW = embedded.width + margin * 2;
				pageH = embedded.height + margin * 2;
			} else {
				[pageW, pageH] = PAGE[mode];
			}
			const page = pdf.addPage([pageW, pageH]);
			const availW = pageW - margin * 2;
			const availH = pageH - margin * 2;
			const scale = Math.min(availW / embedded.width, availH / embedded.height);
			const drawW = embedded.width * scale;
			const drawH = embedded.height * scale;
			page.drawImage(embedded, {
				x: (pageW - drawW) / 2,
				y: (pageH - drawH) / 2,
				width: drawW,
				height: drawH,
			});
			img.bitmap.close();
		}
		const out = await pdf.save();
		const blob = new Blob([out as unknown as BlobPart], { type: "application/pdf" });
		status.innerHTML = `已生成：<b>${formatBytes(blob.size)}</b>，共 ${files.length} 页。`;
		const btn = document.createElement("button");
		btn.textContent = "下载 PDF";
		btn.addEventListener("click", () => {
			const url = URL.createObjectURL(blob);
			const a = document.createElement("a");
			a.href = url;
			a.download = `${fnameIn.value || "merged"}.pdf`;
			a.click();
			setTimeout(() => URL.revokeObjectURL(url), 4000);
		});
		status.appendChild(document.createElement("br"));
		status.appendChild(btn);
	} catch (err) {
		status.textContent = `生成失败：${(err as Error).message}`;
	}
	runBtn.disabled = false;
});
</script>
