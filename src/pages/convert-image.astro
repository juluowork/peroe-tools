---
import Base from "../layouts/Base.astro";
import { toolBySlug } from "../lib/tools";

const tool = toolBySlug("convert-image")!;
const FAQ = tool.faq;
const faqLd = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: FAQ.map((f) => ({
		"@type": "Question",
		name: f.q,
		aacceptedAnswer: { "@type": "Answer", text: f.a },
	})),
};
---

<Base title={tool.title} description={tool.description} jsonLd={faqLd}>
	<span class="badge">本地转换 · 不上传</span>
	<h1>图片格式转换</h1>
	<p class="lead">
		JPG、PNG、WebP（以及浏览器支持的 AVIF）之间互转，可指定透明区填充色与画质。
		文件只在本机内存里转换，<b>不上传服务器</b>。
	</p>

	<div class="card">
		<div class="dropzone" id="dz">点击选择图片，或把图片拖到这里（可多选）</div>
		<input id="file" type="file" accept="image/*" multiple hidden />
		<div class="row">
			<label class="field">目标格式
				<select id="target">
					<option value="image/webp">WebP</option>
					<option value="image/jpeg">JPG</option>
					<option value="image/png">PNG</option>
					<option value="image/avif">AVIF（视浏览器支持）</option>
				</select>
			</label>
			<label class="field">透明区填充色
				<select id="bg">
					<option value="">保持透明（PNG/WebP）</option>
					<option value="#ffffff">白色</option>
					<option value="#000000">黑色</option>
				</select>
			</label>
			<label class="field">画质 <span id="qv">88%</span>
				<input id="quality" type="range" min="35" max="100" value="88" />
			</label>
			<button id="run" disabled>开始转换</button>
		</div>
		<p class="hint" id="support"></p>
	</div>

	<ul class="results" id="results"></ul>

	<div class="ad-slot" data-ad-slot="tool-mid"></div>

	<h2>该选哪种格式</h2>
	<ul>
		<li><b>WebP</b>：体积与画质最均衡，支持透明，现代浏览器全支持 —— 网页配图首选。</li>
		<li><b>JPG</b>：兼容性最好，但不支持透明、不适合线条图与文字截图（会有色块）。</li>
		<li><b>PNG</b>：无损、支持透明，适合图标、截图、线稿；照片类会非常大。</li>
		<li><b>AVIF</b>：同画质下最小，但编码慢、部分老旧软件不支持。</li>
	</ul>

	<h2>常见问题</h2>
	{FAQ.map((f) => (
		<details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>
	))}
</Base>

<script>
	import { bindDropZone, encode, download, formatBytes, loadImage, replaceExt, extFor, supportsType } from "../lib/imgtools.client";

	const dz = document.getElementById("dz")!;
	const input = document.getElementById("file") as HTMLInputElement;
	const runBtn = document.getElementById("run") as HTMLButtonElement;
	const results = document.getElementById("results")!;
	const target = document.getElementById("target") as HTMLSelectElement;
	const bg = document.getElementById("bg") as HTMLSelectElement;
	const quality = document.getElementById("quality") as HTMLInputElement;
	const qv = document.getElementById("qv")!;
	const support = document.getElementById("support")!;

	const avifOk = supportsType("image/avif");
	support.textContent = avifOk
		? "当前浏览器支持导出 AVIF。"
		: "当前浏览器不支持导出 AVIF，请改用 WebP（体积接近）。";
	(target.querySelector('option[value="image/avif"]') as HTMLOptionElement).disabled = !avifOk;

	let files: File[] = [];
	quality.addEventListener("input", () => (qv.textContent = `${quality.value}%`));
	bindDropZone(dz, input, (picked) => {
		files = picked.filter((f) => f.type.startsWith("image/"));
		runBtn.disabled = files.length === 0;
		dz.textContent = files.length ? `已选择 ${files.length} 张，点击可重新选择` : "点击选择图片，或把图片拖到这里（可多选）";
	});

	runBtn.addEventListener("click", async () => {
	runBtn.disabled = true;
	results.innerHTML = "";
	const mime = target.value;
	for (const file of files) {
		const li = document.createElement("li");
		li.innerHTML = `<span class="name">${file.name}</span><span class="size">转换中…</span>`;
		results.appendChild(li);
		try {
			const img = await loadImage(file);
			const needBg = mime === "image/jpeg" && !bg.value ? "#ffffff" : bg.value || null;
			const blob = await encode(img, { mime, quality: Number(quality.value) / 100, background: needBg });
			const url = URL.createObjectURL(blob);
			li.innerHTML = `
				<img class="thumb" src="${url}" alt="" />
				<span class="name">${file.name} → ${extFor(mime)}</span>
				<span class="size">${formatBytes(file.size)} → <b>${formatBytes(blob.size)}</b></span>`;
			const btn = document.createElement("button");
			btn.textContent = "下载";
			btn.addEventListener("click", () => download(blob, replaceExt(file.name, extFor(mime))));
			li.appendChild(btn);
			img.bitmap.close();
		} catch (err) {
			li.innerHTML = `<span class="name">${file.name}</span><span class="size">失败：${(err as Error).message}</span>`;
		}
	}
	runBtn.disabled = false;
});
</script>
