---
import type { GetStaticPaths } from "astro";
import ToolPage from "../../../components/ToolPage.astro";
import CompressTool from "../../../components/tools/CompressTool.astro";
import ConvertTool from "../../../components/tools/ConvertTool.astro";
import ResizeTool from "../../../components/tools/ResizeTool.astro";
import ImageToPdfTool from "../../../components/tools/ImageToPdfTool.astro";
import MergePdfTool from "../../../components/tools/MergePdfTool.astro";
import SplitPdfTool from "../../../components/tools/SplitPdfTool.astro";
import PdfToImagesTool from "../../../components/tools/PdfToImagesTool.astro";
import CompressPdfTool from "../../../components/tools/CompressPdfTool.astro";
import WatermarkPdfTool from "../../../components/tools/WatermarkPdfTool.astro";
import PageNumbersPdfTool from "../../../components/tools/PageNumbersPdfTool.astro";
import OrganizePdfTool from "../../../components/tools/OrganizePdfTool.astro";
import ExtractPdfTextTool from "../../../components/tools/ExtractPdfTextTool.astro";
import { getSite, getTools } from "../../../i18n";
import type { ToolCopy } from "../../../i18n";

const locale = "zh" as const;

export const getStaticPaths = (() =>
	getTools("zh").map((tool) => ({
		params: { category: tool.category, slug: tool.slug },
		props: { tool },
	}))) satisfies GetStaticPaths;

const { tool } = Astro.props as { tool: ToolCopy };
const site = getSite(locale);
const tools = getTools(locale);
const components: Record<string, typeof CompressTool> = {
	"compress-image": CompressTool,
	"convert-image": ConvertTool,
	"resize-image": ResizeTool,
	"image-to-pdf": ImageToPdfTool,
	"merge-pdf": MergePdfTool,
	"split-pdf": SplitPdfTool,
	"pdf-to-images": PdfToImagesTool,
	"compress-pdf": CompressPdfTool,
	"watermark-pdf": WatermarkPdfTool,
	"page-numbers-pdf": PageNumbersPdfTool,
	"organize-pdf": OrganizePdfTool,
	"extract-pdf-text": ExtractPdfTextTool,
};
const Tool = components[tool.slug];
---

<ToolPage locale={locale} site={site} tools={tools} tool={tool}>
	<Tool ui={tool.ui} privacy={site.footerNote} />
</ToolPage>
