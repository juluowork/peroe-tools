---
import Base from "../layouts/Base.astro";
import { toolBySlug } from "../lib/tools";

const tool = toolBySlug("compress-image")!;
const FAQ = tool.faq;
const faqLd = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: FAQ.map((f) => ({
		"@type": "Question",
		name: f.q,
		aacceptedAnswer: { "@type": "Answer", text: f.a },
	})),
};
---

<Base title={tool.title} description={tool.description} jsonLd={faqLd}>
	<span class="badge">本地压缩 · 不上传</span>
	<h1>图片压缩</h1>
	<p class="lead">
		把 JPG、PNG、WebP 压到更小体积，可调画质、支持一次处理多张。
		压缩在浏览器里用 Canvas 完成，图片<b>不会上传到任何服务器</b>。
	</p>

	<div class="card">
		<div class="dropzone" id="dz">点击选择图片，或把图片拖到这里（可多选）</div>
		<input id="file" type="file" accept="image/*" multiple hidden />

		<div class="row">
			<label class="field">输出格式
				<select id="format">
					<option value="keep">保持原格式</option>
					<option value="image/webp">WebP（通常最小）</option>
					<option value="image/jpeg">JPG</option>
					<option value="image/png">PNG（无损，体积较大）</option>
				</select>
			</label>
			<label class="field">画质 <span id="qv">82%</span>
				<input id="quality" type="range" min="35" max="100" value="82" />
			</label>
			<label class="field">目标体积（可选，KB）
				<input id="maxkb" type="number" min="10" step="10" placeholder="例如 200" />
			</label>
			<button id="run" disabled>开始压缩</button>
			<button id="clear" class="ghost">清空</button>
		</div>
		<p class="hint">提示：目标体积会先按画质压缩，若仍偏大则自动降画质重试（最多 5 次）。</p>
	</div>

	<ul class="results" id="results"></ul>

	<div class="ad-slot" data-ad-slot="tool-mid"></div>

	<h2>它是怎么工作的</h2>
	<p>
		浏览器提供了完整的图片编解码能力：<code>createImageBitmap()</code> 把文件解码成位图，
		画到 <code>&lt;canvas&gt;</code> 上，再用 <code>canvas.toBlob()</code> 以你指定的编码器和画质重新压缩。
		整个过程只发生在内存里，产物是一个 <code>Blob</code>，点「下载」时通过 <code>URL.createObjectURL()</code>
		直接交给浏览器的下载器 —— <b>没有任何一步需要网络</b>。
	</p>
	<h3>压缩建议</h3>
	<ul>
		<li><b>网页配图</b>：选 WebP、画质 75%~82%，通常比原始 JPG 小 40% 以上。</li>
		<li><b>需要透明背景</b>：用 WebP 或 PNG；JPG 不支持透明，透明区会被填黑。</li>
		<li><b>截图/线框图</b>：PNG 无损更清晰，但体积大；如无透明需求，转 WebP 更划算。</li>
	</ul>

	<h2>常见问题</h2>
	{FAQ.map((f) => (
		<details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>
	))}
</Base>

<script>
	import { bindDropZone, encode, download, formatBytes, loadImage, replaceExt, extFor } from "../lib/imgtools.client";

	const dz = document.getElementById("dz")!;
	const input = document.getElementById("file") as HTMLInputElement;
	const runBtn = document.getElementById("run") as HTMLButtonElement;
	const clearBtn = document.getElementById("clear") as HTMLButtonElement;
	const results = document.getElementById("results")!;
	const quality = document.getElementById("quality") as HTMLInputElement;
	const qv = document.getElementById("qv")!;
	const format = document.getElementById("format") as HTMLSelectElement;
	const maxkb = document.getElementById("maxkb") as HTMLInputElement;

	let files: File[] = [];
	quality.addEventListener("input", () => (qv.textContent = `${quality.value}%`));
	bindDropZone(dz, input, (picked) => {
		files = picked.filter((f) => f.type.startsWith("image/"));
		runBtn.disabled = files.length === 0;
		dz.textContent = files.length ? `已选择 ${files.length} 张图片，点击可重新选择` : "点击选择图片，或把图片拖到这里（可多选）";
	});
	clearBtn.addEventListener("click", () => {
		files = [];
		results.innerHTML = "";
		runBtn.disabled = true;
		dz.textContent = "点击选择图片，或把图片拖到这里（可多选）";
	});

	runBtn.addEventListener("click", async () => {
	runBtn.disabled = true;
	results.innerHTML = "";
	for (const file of files) {
		const li = document.createElement("li");
		li.innerHTML = `<span class="name">${file.name}</span><span class="size">处理中…</span>`;
		results.appendChild(li);
		try {
			const img = await loadImage(file);
			const mime = format.value === "keep" ? (file.type || "image/jpeg") : format.value;
			const kb = Number(maxkb.value || 0);
			const blob = await encode(img, {
				mime,
				quality: Number(quality.value) / 100,
				background: mime === "image/jpeg" ? "#ffffff" : null,
				maxBytes: kb > 0 ? kb * 1024 : undefined,
			});
			const saved = 1 - blob.size / file.size;
			const url = URL.createObjectURL(blob);
			li.innerHTML = `
				<img class="thumb" src="${url}" alt="" />
				<span class="name">${file.name}</span>
				<span class="size">${formatBytes(file.size)} → <b>${formatBytes(blob.size)}</b>
					<span class="save">${saved > 0 ? `省 ${(saved * 100).toFixed(0)}%` : "未变小"}</span></span>`;
			const btn = document.createElement("button");
			btn.textContent = "下载";
			btn.addEventListener("click", () => download(blob, replaceExt(file.name, extFor(mime))));
			li.appendChild(btn);
			img.bitmap.close();
		} catch (err) {
			li.innerHTML = `<span class="name">${file.name}</span><span class="size">失败：${(err as Error).message}</span>`;
		}
	}
	runBtn.disabled = false;
});
</script>
