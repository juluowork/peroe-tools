---
import "../styles/global.css";
import ToolNav from "../components/ToolNav.astro";
import type { Locale, SiteCopy, ToolCopy } from "../i18n";
import { htmlLang, localePath } from "../i18n";

interface Props {
	locale: Locale;
	site: SiteCopy;
	tools: ToolCopy[];
	title: string;
	description: string;
	/** 不含语言前缀的路径，如 "/" 或 "/compress-image/" */
	path: string;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { locale, site, tools, title, description, path } = Astro.props;
const jsonLdList = Astro.props.jsonLd ? (Array.isArray(Astro.props.jsonLd) ? Astro.props.jsonLd : [Astro.props.jsonLd]) : [];
const origin = Astro.site?.origin ?? "https://tools.juluo.work";
const canonical = origin + localePath(locale, path);
const alt = origin + localePath(locale === "en" ? "zh" : "en", path);
---

<!doctype html>
<html lang={htmlLang(locale)}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="en" href={origin + localePath("en", path)} />
		<link rel="alternate" hreflang="zh-CN" href={origin + localePath("zh", path)} />
		<link rel="alternate" hreflang="x-default" href={origin + localePath("en", path)} />
		<meta name="robots" content="index,follow,max-image-preview:large" />
		<meta name="theme-color" content="#00bb88" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={locale === "en" ? "en_US" : "zh_CN"} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<!-- PWA：可安装 + 真离线（见 public/sw.js）。这是纯前端架构才能给的保证 -->
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		{jsonLdList.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
		<!-- 站长验证：Bing（token 是账号级的，与博客同一串；另有 public/BingSiteAuth.xml 兜底） -->
		<meta name="msvalidate.01" content="91E5B16A2CD2E86042B923AF197EC312" />
		<!-- 统计：Umami Cloud（无 Cookie、不采集个人数据）；data-domains 限定正式域名，避免本地调试污染数据 -->
		<script
			is:inline
			defer
			src="https://cloud.umami.is/script.js"
			data-website-id="bc70c244-bba3-4e53-b275-c405b930c82e"
			data-domains="tools.juluo.work"
		></script>
		<!-- 注册 Service Worker：只在正式域名上注册，避免本地调试被缓存干扰 -->
		<script is:inline>
			if ("serviceWorker" in navigator && location.hostname === "tools.juluo.work") {
				window.addEventListener("load", function () {
					navigator.serviceWorker.register("/sw.js").catch(function () {});
				});
			}
		</script>
	</head>
	<body>
		<header class="site-header">
			<div class="wrap">
				<a class="brand" href={localePath(locale, "/")}>
					<span class="dot"></span>{site.brand}
				</a>
				<ToolNav locale={locale} site={site} tools={tools} path={path} />
			</div>
		</header>
		<main>
			<div class="wrap">
				<slot />
			</div>
		</main>
		<footer class="site-footer">
			<div class="wrap">
				<span>{site.footerNote}</span>
				<span class="footer-links">
					<a href={localePath(locale, "/tools/")}>{site.navAllTools}</a>
					<a href={localePath(locale, "/why-local/")}>{locale === "en" ? "Why nothing is uploaded" : "为什么不上传"}</a>
					{site.footerLinks.map((l) => <a href={l.href}>{l.label}</a>)}
					<a href={`mailto:${site.email}`} title={site.contactLabel}>
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" style="vertical-align:-2px;margin-right:4px">
							<rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />
						</svg>{site.email}
					</a>
				</span>
			</div>
		</footer>
	</body>
</html>
