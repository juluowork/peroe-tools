---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import type { Locale, SiteCopy, ToolCopy } from "../i18n";
import { htmlLang, localePath } from "../i18n";

interface Props {
	locale: Locale;
	site: SiteCopy;
	tools: ToolCopy[];
	title: string;
	description: string;
	/** 不含语言前缀的路径，如 "/" 或 "/compress-image/" */
	path: string;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { locale, site, tools, title, description, path } = Astro.props;
const jsonLdList = Astro.props.jsonLd ? (Array.isArray(Astro.props.jsonLd) ? Astro.props.jsonLd : [Astro.props.jsonLd]) : [];
const origin = Astro.site?.origin ?? "https://tools.juluo.work";
const canonical = origin + localePath(locale, path);
const alt = origin + localePath(locale === "en" ? "zh" : "en", path);
---

<!doctype html>
<html lang={htmlLang(locale)}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="en" href={origin + localePath("en", path)} />
		<link rel="alternate" hreflang="zh-CN" href={origin + localePath("zh", path)} />
		<link rel="alternate" hreflang="x-default" href={origin + localePath("en", path)} />
		<meta name="robots" content="index,follow,max-image-preview:large" />
		<meta name="theme-color" content="#00bb88" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={locale === "en" ? "en_US" : "zh_CN"} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		{jsonLdList.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
	</head>
	<body>
		<header class="site-header">
			<div class="wrap">
				<a class="brand" href={localePath(locale, "/")}>
					<span class="dot"></span>{site.brand}
				</a>
				<nav class="site-nav" aria-label={site.navLabel}>
					{tools.map((t) => <a href={localePath(locale, `/${t.slug}/`)}>{t.nav}</a>)}
				</nav>
				<a class="lang-switch" href={localePath(locale === "en" ? "zh" : "en", path)}>{site.switchLabel}</a>
			</div>
		</header>
		<main>
			<div class="wrap">
				<slot />
			</div>
		</main>
		<footer class="site-footer">
			<div class="wrap">
				<span>{site.footerNote}</span>
				<span>
					{site.footerLinks.map((l) => <a href={l.href}>{l.label}</a>)}
				</span>
			</div>
		</footer>
	</body>
</html>
