---
import type { ToolCopy } from "../../i18n";
import DropZone from "../DropZone.astro";

interface Props {
	ui: ToolCopy["ui"];
	privacy: string;
}
const { ui, privacy } = Astro.props;
---

<script type="application/json" id="tool-ui" set:html={JSON.stringify(ui)} />

<div class="tool">
	<DropZone id="dz" title={ui.dropzone} sub={ui.orDrop} privacy={privacy} />
	<input id="file" type="file" accept="image/*" multiple hidden />

	<ul class="filelist" id="list"></ul>

	<div class="options" id="options" hidden>
		<label class="field"><span class="lbl">{ui.format}</span>
			<select id="format">
				<option value="keep">{ui.formatKeep}</option>
				<option value="image/webp">{ui.formatWebp}</option>
				<option value="image/jpeg">{ui.formatJpg}</option>
				<option value="image/png">{ui.formatPng}</option>
			</select>
		</label>
		<label class="field"><span class="lbl">{ui.quality} <b id="qv">82%</b></span>
			<input id="quality" type="range" min="35" max="100" value="82" />
		</label>
		<label class="field"><span class="lbl">{ui.targetSize}</span>
			<input id="maxkb" type="number" min="10" step="10" />
		</label>
	</div>

	<div class="btns" id="actions" hidden>
		<button class="btn-primary" id="run">{ui.run}</button>
		<button class="btn-ghost" id="add">{ui.addMore}</button>
		<button class="btn-link" id="reset">{ui.startOver}</button>
	</div>
</div>

<script>
	import {
		bindDropZone, clearBusy, download, encode, escapeHtml, extFor, formatBytes,
		loadImage, opButton, renderRow, replaceExt, setBusy,
	} from "../../lib/imgtools.client";

	const ui = JSON.parse(document.getElementById("tool-ui")!.textContent || "{}");
	const dz = document.getElementById("dz")!;
	const input = document.getElementById("file") as HTMLInputElement;
	const list = document.getElementById("list")!;
	const options = document.getElementById("options")!;
	const actions = document.getElementById("actions")!;
	const runBtn = document.getElementById("run") as HTMLButtonElement;
	const quality = document.getElementById("quality") as HTMLInputElement;
	const qv = document.getElementById("qv")!;
	const format = document.getElementById("format") as HTMLSelectElement;
	const maxkb = document.getElementById("maxkb") as HTMLInputElement;
	let files: File[] = [];

	quality.addEventListener("input", () => (qv.textContent = `${quality.value}%`));

	function renderBase() {
		list.innerHTML = "";
		files.forEach((f) => list.appendChild(renderRow({ name: f.name, sizeText: formatBytes(f.size), thumbUrl: URL.createObjectURL(f) })));
		options.hidden = files.length === 0;
		actions.hidden = files.length === 0;
	}
	bindDropZone(dz, input, (picked) => {
		files = files.concat(picked.filter((f) => f.type.startsWith("image/")));
		dz.classList.add("is-compact");
		renderBase();
	});
	document.getElementById("add")!.addEventListener("click", () => input.click());
	document.getElementById("reset")!.addEventListener("click", () => {
		files = [];
		dz.classList.remove("is-compact");
		renderBase();
	});

	runBtn.addEventListener("click", async () => {
	renderBase();
	const rows = [...list.children] as HTMLLIElement[];
	for (let i = 0; i < files.length; i++) {
		const file = files[i];
		const li = rows[i];
		setBusy(runBtn, `${ui.working} ${i + 1}/${files.length}`);
		try {
			const img = await loadImage(file);
			const mime = format.value === "keep" ? file.type || "image/jpeg" : format.value;
			const kb = Number(maxkb.value || 0);
			const blob = await encode(img, {
				mime,
				quality: Number(quality.value) / 100,
				background: mime === "image/jpeg" ? "#ffffff" : null,
				maxBytes: kb > 0 ? kb * 1024 : undefined,
			});
			// 关键修复：压完反而更大就保留原图，绝不给用户更差的文件
			const smaller = blob.size < file.size;
			const out = smaller ? blob : file;
			const outName = smaller ? replaceExt(file.name, extFor(mime)) : file.name;
			li.querySelector(".fsize")!.innerHTML = smaller
				? `${formatBytes(file.size)} → <b>${formatBytes(out.size)}</b> <span class="save">${ui.saved} ${((1 - out.size / file.size) * 100).toFixed(0)}%</span>`
				: `${formatBytes(file.size)} → <b>${formatBytes(out.size)}</b>`;
			if (!smaller) {
				const note = document.createElement("div");
				note.className = "note-warn";
				note.textContent = ui.notSmaller;
				li.querySelector(".meta")!.appendChild(note);
			}
			li.querySelector(".ops")!.appendChild(opButton(ui.download, "primary", () => download(out, outName)));
			img.bitmap.close();
		} catch (err) {
			li.querySelector(".fsize")!.innerHTML = `<span class="note-warn">${escapeHtml(ui.failed)}: ${escapeHtml((err as Error).message)}</span>`;
		}
	}
	clearBusy(runBtn);
});
</script>
