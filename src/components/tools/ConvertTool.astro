---
import type { ToolCopy } from "../../i18n";
import DropZone from "../DropZone.astro";

interface Props {
	ui: ToolCopy["ui"];
	privacy: string;
}
const { ui, privacy } = Astro.props;
---

<script type="application/json" id="tool-ui" set:html={JSON.stringify(ui)} />

<div class="tool">
	<DropZone id="dz" title={ui.dropzone} sub={ui.orDrop} privacy={privacy} />
	<input id="file" type="file" accept="image/*" multiple hidden />

	<ul class="filelist" id="list"></ul>

	<div class="options" id="options" hidden>
		<label class="field"><span class="lbl">{ui.target}</span>
			<select id="target">
				<option value="image/webp">WebP</option>
				<option value="image/jpeg">JPG</option>
				<option value="image/png">PNG</option>
				<option value="image/avif">AVIF</option>
			</select>
		</label>
		<label class="field"><span class="lbl">{ui.background}</span>
			<select id="bg">
				<option value="">{ui.bgKeep}</option>
				<option value="#ffffff">{ui.bgWhite}</option>
				<option value="#000000">{ui.bgBlack}</option>
			</select>
		</label>
		<label class="field"><span class="lbl">{ui.quality} <b id="qv">88%</b></span>
			<input id="quality" type="range" min="35" max="100" value="88" />
		</label>
	</div>
	<p class="small muted" id="support" style="margin-top:12px"></p>

	<div class="btns" id="actions" hidden>
		<button class="btn-primary" id="run">{ui.run}</button>
		<button class="btn-ghost" id="add">{ui.addMore}</button>
		<button class="btn-link" id="reset">{ui.startOver}</button>
	</div>
</div>

<script>
	import {
		bindDropZone, clearBusy, download, encode, escapeHtml, extFor, formatBytes,
		loadImage, opButton, renderRow, replaceExt, setBusy, supportsType,
	} from "../../lib/imgtools.client";

	const ui = JSON.parse(document.getElementById("tool-ui")!.textContent || "{}");
	const dz = document.getElementById("dz")!;
	const input = document.getElementById("file") as HTMLInputElement;
	const list = document.getElementById("list")!;
	const options = document.getElementById("options")!;
	const actions = document.getElementById("actions")!;
	const runBtn = document.getElementById("run") as HTMLButtonElement;
	const target = document.getElementById("target") as HTMLSelectElement;
	const bg = document.getElementById("bg") as HTMLSelectElement;
	const quality = document.getElementById("quality") as HTMLInputElement;
	const qv = document.getElementById("qv")!;
	const support = document.getElementById("support")!;
	let files: File[] = [];

	const avifOk = supportsType("image/avif");
	support.textContent = avifOk ? ui.avifOk : ui.avifNo;
	(target.querySelector('option[value="image/avif"]') as HTMLOptionElement).disabled = !avifOk;

	quality.addEventListener("input", () => (qv.textContent = `${quality.value}%`));
	function renderBase() {
		list.innerHTML = "";
		files.forEach((f) => list.appendChild(renderRow({ name: f.name, sizeText: formatBytes(f.size), thumbUrl: URL.createObjectURL(f) })));
		options.hidden = files.length === 0;
		actions.hidden = files.length === 0;
	}
	bindDropZone(dz, input, (picked) => {
		files = files.concat(picked.filter((f) => f.type.startsWith("image/")));
		dz.classList.add("is-compact");
		renderBase();
	});
	document.getElementById("add")!.addEventListener("click", () => input.click());
	document.getElementById("reset")!.addEventListener("click", () => {
		files = [];
		dz.classList.remove("is-compact");
		renderBase();
	});

	runBtn.addEventListener("click", async () => {
	renderBase();
	const rows = [...list.children] as HTMLLIElement[];
	const mime = target.value;
	for (let i = 0; i < files.length; i++) {
		const file = files[i];
		const li = rows[i];
		setBusy(runBtn, `${ui.working} ${i + 1}/${files.length}`);
		try {
			const img = await loadImage(file);
			const needBg = mime === "image/jpeg" ? bg.value || "#ffffff" : bg.value || null;
			const blob = await encode(img, { mime, quality: Number(quality.value) / 100, background: needBg });
			li.querySelector(".fsize")!.innerHTML = `${formatBytes(file.size)} → <b>${formatBytes(blob.size)}</b> · ${extFor(mime).toUpperCase()}`;
			li.querySelector(".ops")!.appendChild(opButton(ui.download, "primary", () => download(blob, replaceExt(file.name, extFor(mime)))));
			img.bitmap.close();
		} catch (err) {
			li.querySelector(".fsize")!.innerHTML = `<span class="note-warn">${escapeHtml(ui.failed)}: ${escapeHtml((err as Error).message)}</span>`;
		}
	}
	clearBusy(runBtn);
});
</script>
