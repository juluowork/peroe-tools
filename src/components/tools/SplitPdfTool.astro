---
import type { ToolCopy } from "../../i18n";
import DropZone from "../DropZone.astro";

interface Props {
	ui: ToolCopy["ui"];
	privacy: string;
}
const { ui, privacy } = Astro.props;
---

<script type="application/json" id="tool-ui" set:html={JSON.stringify(ui)} />

<div class="tool">
	<DropZone id="dz" title={ui.dropzone} sub={ui.orDrop} privacy={privacy} />
	<input id="file" type="file" accept="application/pdf,.pdf" hidden />

	<ul class="filelist" id="list"></ul>

	<div class="options" id="options" hidden>
		<label class="field"><span class="lbl">{ui.range}</span>
			<input id="range" type="text" placeholder="1-3, 5, 8-10" />
		</label>
		<label class="field"><span class="lbl">{ui.mode}</span>
			<select id="mode">
				<option value="one">{ui.modeOne}</option>
				<option value="each">{ui.modeEach}</option>
			</select>
		</label>
		<label class="field"><span class="lbl">{ui.filename}</span>
			<input id="fname" type="text" value="pages" />
		</label>
	</div>

	<div class="btns" id="actions" hidden>
		<button class="btn-primary" id="run">{ui.run}</button>
		<button class="btn-link" id="reset">{ui.startOver}</button>
	</div>
	<p class="empty" id="status"></p>
</div>

<script>
	import { bindDropZone, clearBusy, escapeHtml, formatBytes, opButton, renderRow, setBusy } from "../../lib/imgtools.client";
	import { parsePageRanges } from "../../lib/pdfjs.client";

	const ui = JSON.parse(document.getElementById("tool-ui")!.textContent || "{}");
	const dz = document.getElementById("dz")!;
	const input = document.getElementById("file") as HTMLInputElement;
	const list = document.getElementById("list")!;
	const options = document.getElementById("options")!;
	const actions = document.getElementById("actions")!;
	const runBtn = document.getElementById("run") as HTMLButtonElement;
	const status = document.getElementById("status")!;
	const range = document.getElementById("range") as HTMLInputElement;
	const mode = document.getElementById("mode") as HTMLSelectElement;
	const fname = document.getElementById("fname") as HTMLInputElement;
	let file: File | null = null;
	let pageCount = 0;

	async function setFile(picked: File[]) {
		const pdf = picked.find((f) => f.type === "application/pdf" || /\.pdf$/i.test(f.name));
		if (!pdf) return;
		file = pdf;
		dz.classList.add("is-compact");
		list.innerHTML = "";
		const li = renderRow({ name: pdf.name, sizeText: formatBytes(pdf.size) });
		li.querySelector(".ops")!.append(opButton(ui.remove, "danger", () => {
			file = null;
			list.innerHTML = "";
			options.hidden = true;
			actions.hidden = true;
			status.textContent = "";
			dz.classList.remove("is-compact");
		}));
		list.appendChild(li);
		options.hidden = false;
		actions.hidden = false;
		try {
			const { PDFDocument } = await import("pdf-lib");
			const doc = await PDFDocument.load(await pdf.arrayBuffer(), { ignoreEncryption: true });
			pageCount = doc.getPageCount();
			li.querySelector(".fsize")!.innerHTML = `${formatBytes(pdf.size)} · <b>${pageCount}</b> ${ui.pages}`;
			range.placeholder = `1-${pageCount}`;
		} catch {
			li.querySelector(".fsize")!.innerHTML = `${formatBytes(pdf.size)} · <span class="note-warn">${ui.unreadable}</span>`;
		}
	}

	bindDropZone(dz, input, setFile);
	document.getElementById("reset")!.addEventListener("click", () => {
		file = null;
		list.innerHTML = "";
		options.hidden = true;
		actions.hidden = true;
		status.textContent = "";
		dz.classList.remove("is-compact");
	});

	function download(blob: Blob, name: string) {
		const url = URL.createObjectURL(blob);
		const a = document.createElement("a");
		a.href = url;
		a.download = name;
		a.click();
		setTimeout(() => URL.revokeObjectURL(url), 4000);
	}

	runBtn.addEventListener("click", async () => {
	if (!file) return;
	setBusy(runBtn, ui.working);
	status.textContent = "";
	try {
		const { PDFDocument } = await import("pdf-lib");
		const src = await PDFDocument.load(await file.arrayBuffer(), { ignoreEncryption: true });
		const total = src.getPageCount();
		const pages = range.value.trim() ? parsePageRanges(range.value, total) : src.getPageIndices().map((i) => i + 1);
		if (pages.length === 0) {
			status.innerHTML = `<span class="note-warn">${escapeHtml(ui.badRange)}</span>`;
			clearBusy(runBtn);
			return;
		}
		if (mode.value === "one") {
			const out = await PDFDocument.create();
			const copied = await out.copyPages(src, pages.map((p) => p - 1));
			for (const p of copied) out.addPage(p);
			const blob = new Blob([(await out.save()) as unknown as BlobPart], { type: "application/pdf" });
			status.innerHTML = `${ui.done}: <b>${formatBytes(blob.size)}</b> · ${pages.length} ${ui.pages}`;
			const bar = document.createElement("div");
			bar.className = "btns";
			bar.append(opButton(ui.download, "primary", () => download(blob, `${fname.value || "pages"}.pdf`)));
			status.appendChild(bar);
		} else {
			status.innerHTML = `${ui.done} · ${pages.length} ${ui.pages}`;
			const bar = document.createElement("div");
			bar.className = "btns";
			bar.append(
				opButton(ui.downloadAll, "primary", () => {
					bar.querySelectorAll<HTMLButtonElement>("button[data-onepage]").forEach((b, i) => setTimeout(() => b.click(), i * 350));
				}),
			);
			status.appendChild(bar);
			const grid = document.createElement("ul");
			grid.className = "filelist";
			status.appendChild(grid);
			for (const p of pages) {
				const one = await PDFDocument.create();
				const copied = await one.copyPages(src, [p - 1]);
				one.addPage(copied[0]);
				const blob = new Blob([(await one.save()) as unknown as BlobPart], { type: "application/pdf" });
				const li = renderRow({ name: `${fname.value || "page"}-${p}.pdf`, sizeText: formatBytes(blob.size) });
				const btn = opButton(ui.download, "primary", () => download(blob, `${fname.value || "page"}-${p}.pdf`));
				btn.dataset.onepage = String(p);
				li.querySelector(".ops")!.append(btn);
				grid.appendChild(li);
			}
		}
	} catch (err) {
		status.innerHTML = `<span class="note-warn">${escapeHtml(ui.failed)}: ${escapeHtml((err as Error).message)}</span>`;
	}
	clearBusy(runBtn);
});
</script>
