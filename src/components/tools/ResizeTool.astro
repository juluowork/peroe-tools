---
import type { ToolCopy } from "../../i18n";
import DropZone from "../DropZone.astro";

interface Props {
	ui: ToolCopy["ui"];
	privacy: string;
}
const { ui, privacy } = Astro.props;
---

<script type="application/json" id="tool-ui" set:html={JSON.stringify(ui)} />

<div class="tool">
	<DropZone id="dz" title={ui.dropzone} sub={ui.orDrop} privacy={privacy} />
	<input id="file" type="file" accept="image/*" multiple hidden />

	<ul class="filelist" id="list"></ul>

	<div class="options" id="options" hidden>
		<label class="field"><span class="lbl">{ui.width}</span>
			<input id="w" type="number" min="1" step="1" />
		</label>
		<label class="field"><span class="lbl">{ui.height}</span>
			<input id="h" type="number" min="1" step="1" />
		</label>
		<label class="field"><span class="lbl">{ui.percent}</span>
			<input id="pct" type="number" min="1" max="400" step="1" />
		</label>
		<label class="field"><span class="lbl">{ui.lock}</span>
			<select id="lock">
				<option value="1">{ui.lockYes}</option>
				<option value="0">{ui.lockNo}</option>
			</select>
		</label>
	</div>

	<div class="btns" id="actions" hidden>
		<button class="btn-primary" id="run">{ui.run}</button>
		<button class="btn-ghost" id="add">{ui.addMore}</button>
		<button class="btn-link" id="reset">{ui.startOver}</button>
	</div>
</div>

<script>
	import {
		bindDropZone, clearBusy, download, encode, escapeHtml, extFor, formatBytes,
		loadImage, opButton, renderRow, replaceExt, setBusy,
	} from "../../lib/imgtools.client";

	const ui = JSON.parse(document.getElementById("tool-ui")!.textContent || "{}");
	const dz = document.getElementById("dz")!;
	const input = document.getElementById("file") as HTMLInputElement;
	const list = document.getElementById("list")!;
	const options = document.getElementById("options")!;
	const actions = document.getElementById("actions")!;
	const runBtn = document.getElementById("run") as HTMLButtonElement;
	const wIn = document.getElementById("w") as HTMLInputElement;
	const hIn = document.getElementById("h") as HTMLInputElement;
	const pctIn = document.getElementById("pct") as HTMLInputElement;
	const lock = document.getElementById("lock") as HTMLSelectElement;
	let files: File[] = [];

	function renderBase() {
		list.innerHTML = "";
		files.forEach((f) => list.appendChild(renderRow({ name: f.name, sizeText: formatBytes(f.size), thumbUrl: URL.createObjectURL(f) })));
		options.hidden = files.length === 0;
		actions.hidden = files.length === 0;
	}
	bindDropZone(dz, input, (picked) => {
		files = files.concat(picked.filter((f) => f.type.startsWith("image/")));
		dz.classList.add("is-compact");
		renderBase();
	});
	document.getElementById("add")!.addEventListener("click", () => input.click());
	document.getElementById("reset")!.addEventListener("click", () => {
		files = [];
		dz.classList.remove("is-compact");
		renderBase();
	});

	runBtn.addEventListener("click", async () => {
	const tw0 = Number(wIn.value || 0);
	const th0 = Number(hIn.value || 0);
	const pct = Number(pctIn.value || 0);
	if (!tw0 && !th0 && !pct) {
		alert(ui.needValue);
		return;
	}
	const keepRatio = lock.value === "1";
	renderBase();
	const rows = [...list.children] as HTMLLIElement[];
	for (let i = 0; i < files.length; i++) {
		const file = files[i];
		const li = rows[i];
		setBusy(runBtn, `${ui.working} ${i + 1}/${files.length}`);
		try {
			const img = await loadImage(file);
			let tw = img.width;
			let th = img.height;
			if (pct) {
				tw = Math.round((img.width * pct) / 100);
				th = Math.round((img.height * pct) / 100);
			} else if (tw0 && th0) {
				tw = tw0;
				th = keepRatio ? Math.round((img.height * tw0) / img.width) : th0;
			} else if (tw0) {
				tw = tw0;
				th = Math.round((img.height * tw0) / img.width);
			} else {
				th = th0;
				tw = Math.round((img.width * th0) / img.height);
			}
			const mime = file.type === "image/png" || file.type === "image/webp" ? file.type : "image/jpeg";
			const blob = await encode(img, {
				mime, quality: 0.92, width: tw, height: th,
				background: mime === "image/jpeg" ? "#ffffff" : null,
			});
			li.querySelector(".fsize")!.innerHTML = `${img.width}×${img.height} → <b>${tw}×${th}</b> · ${formatBytes(blob.size)}`;
			li.querySelector(".ops")!.appendChild(opButton(ui.download, "primary", () => download(blob, replaceExt(file.name, extFor(mime)))));
			img.bitmap.close();
		} catch (err) {
			li.querySelector(".fsize")!.innerHTML = `<span class="note-warn">${escapeHtml(ui.failed)}: ${escapeHtml((err as Error).message)}</span>`;
		}
	}
	clearBusy(runBtn);
});
</script>
