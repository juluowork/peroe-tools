---
import type { ToolCopy } from "../../i18n";
import DropZone from "../DropZone.astro";

interface Props {
	ui: ToolCopy["ui"];
	privacy: string;
}
const { ui, privacy } = Astro.props;
---

<script type="application/json" id="tool-ui" set:html={JSON.stringify(ui)} />

<div class="tool">
	<DropZone id="dz" title={ui.dropzone} sub={ui.orDrop} privacy={privacy} />
	<input id="file" type="file" accept="application/pdf,.pdf" hidden />

	<div id="editor" hidden>
		<div class="sigbar">
			<div class="sigpad">
				<div class="sigpad-head"><b>{ui.signHere}</b><span class="small muted">{ui.signHint}</span></div>
				<canvas id="pad" width="520" height="180"></canvas>
				<div class="sigpad-ops">
					<label class="mini">{ui.ink}<input id="ink" type="color" value="#0b2b6b" /></label>
					<label class="mini">{ui.thickness} <b id="wv">3</b><input id="w" type="range" min="1" max="10" value="3" /></label>
					<button type="button" class="sbtn" id="clearPad">{ui.clearPad}</button>
				</div>
			</div>
			<div class="sigopts">
				<label class="mini">{ui.size} <b id="sv">18</b>%<input id="scale" type="range" min="6" max="45" value="18" /></label>
				<p class="small muted" style="margin:8px 0 0">{ui.placeHint}</p>
				<div class="navrow">
					<button type="button" class="sbtn" id="prev">← {ui.prevPage}</button>
					<span class="small"><b id="pageLabel">1 / 1</b></span>
					<button type="button" class="sbtn" id="next">{ui.nextPage} →</button>
				</div>
				<button type="button" class="sbtn danger" id="undo" style="margin-top:8px">{ui.undoLast}</button>
			</div>
		</div>

		<div class="stage"><canvas id="page"></canvas></div>

		<div class="btns">
			<button class="btn-primary" id="save">{ui.save}</button>
			<button class="btn-link" id="reset">{ui.startOver}</button>
		</div>
		<p class="empty" id="status"></p>
	</div>
</div>

<style>
	.sigbar { display: grid; gap: 14px; grid-template-columns: minmax(280px, 1fr) minmax(220px, 300px); align-items: start; }
	@media (max-width: 760px) { .sigbar { grid-template-columns: 1fr; } }
	.sigpad { border: 1px solid var(--line); border-radius: var(--radius-card); overflow: hidden; background: var(--soft); }
	.sigpad-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; padding: 9px 12px; font-size: 13px; }
	.sigpad canvas { display: block; width: 100%; background: #fff; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); cursor: crosshair; touch-action: none; }
	.sigpad-ops, .sigopts { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; padding: 9px 12px; }
	.sigopts { flex-direction: column; align-items: stretch; border: 1px solid var(--line); border-radius: var(--radius-card); background: var(--soft); }
	.mini { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--muted); }
	.mini input[type="color"] { width: 34px; height: 30px; padding: 2px; cursor: pointer; }
	.mini input[type="range"] { flex: 1; min-width: 90px; }
	.sbtn { font: 500 13px/1 inherit; padding: 8px 12px; min-height: 34px; cursor: pointer; border: 1px solid var(--line); border-radius: var(--radius-btn); background: var(--bg); color: var(--muted); }
	.sbtn:hover { border-color: var(--brand); color: var(--brand-dark); }
	.sbtn.danger:hover { border-color: #e11d48; color: #e11d48; }
	.navrow { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 8px; }
	.stage { margin-top: 14px; border: 1px solid var(--line); border-radius: var(--radius-card); overflow: auto; background: #64748b1a; text-align: center; }
	.stage canvas { display: block; max-width: 100%; margin: 0 auto; cursor: crosshair; }
</style>

<script>
	import { clearBusy, download, escapeHtml, formatBytes, setBusy } from "../../lib/imgtools.client";

	const ui = JSON.parse(document.getElementById("tool-ui")!.textContent || "{}");
	const dz = document.getElementById("dz")!;
	const fileIn = document.getElementById("file") as HTMLInputElement;
	const editor = document.getElementById("editor")!;
	const status = document.getElementById("status")!;
	const pad = document.getElementById("pad") as HTMLCanvasElement;
	const pageCv = document.getElementById("page") as HTMLCanvasElement;
	const saveBtn = document.getElementById("save") as HTMLButtonElement;

	let pdfBytes: Uint8Array | null = null;
	let pdfName = "document";
	let opened: { numPages: number; doc: any } | null = null;
	let pageNo = 1;
	let pageCount = 1;
	let viewScale = 1;
	/** 签名位置按「PDF 坐标」存（原点左下），这样翻页/缩放都不会错位 */
	let placed: { page: number; x: number; y: number; w: number; h: number; dataUrl: string }[] = [];
	let hasInk = false;

	// ---------- 签名板 ----------
	const pctx = pad.getContext("2d")!;
	let drawing = false;
	let last = { x: 0, y: 0 };
	const ink = document.getElementById("ink") as HTMLInputElement;
	const widthIn = document.getElementById("w") as HTMLInputElement;
	widthIn.addEventListener("input", () => (document.getElementById("wv")!.textContent = widthIn.value));
	document.getElementById("scale")!.addEventListener("input", (e) =>
		(document.getElementById("sv")!.textContent = (e.target as HTMLInputElement).value),
	);

	function padPoint(ev: PointerEvent) {
		const r = pad.getBoundingClientRect();
		return { x: ((ev.clientX - r.left) / r.width) * pad.width, y: ((ev.clientY - r.top) / r.height) * pad.height };
	}
	pad.addEventListener("pointerdown", (ev) => {
		pad.setPointerCapture(ev.pointerId);
		drawing = true;
		hasInk = true;
		last = padPoint(ev);
	});
	pad.addEventListener("pointermove", (ev) => {
		if (!drawing) return;
		const p = padPoint(ev);
		pctx.strokeStyle = ink.value;
		pctx.lineWidth = Number(widthIn.value) * 2;
		pctx.lineCap = "round";
		pctx.lineJoin = "round";
		pctx.beginPath();
		pctx.moveTo(last.x, last.y);
		pctx.lineTo(p.x, p.y);
		pctx.stroke();
		last = p;
	});
	const stopDraw = () => (drawing = false);
	pad.addEventListener("pointerup", stopDraw);
	pad.addEventListener("pointercancel", stopDraw);
	document.getElementById("clearPad")!.addEventListener("click", () => {
		pctx.clearRect(0, 0, pad.width, pad.height);
		hasInk = false;
	});

	// ---------- PDF 渲染 ----------
	async function renderPage() {
		if (!opened) return;
		const stage = document.querySelector(".stage") as HTMLElement;
		const base = (await opened.doc.getPage(pageNo)).getViewport({ scale: 1 });
		const maxW = Math.min(760, (stage.clientWidth || 760) - 4);
		viewScale = Math.min(1.6, maxW / base.width);
		const pdfjs = await import("../../lib/pdfjs.client");
		const rendered = await pdfjs.renderPageToCanvas(opened, pageNo, viewScale);
		pageCv.width = rendered.width;
		pageCv.height = rendered.height;
		const g = pageCv.getContext("2d")!;
		g.drawImage(rendered, 0, 0);
		// 把这一页已放置的签名画上去（预览）
		for (const s of placed.filter((p) => p.page === pageNo)) {
			const img = new Image();
			img.src = s.dataUrl;
			await img.decode();
			const px = s.x * viewScale;
			const py = pageCv.height - (s.y + s.h) * viewScale;
			g.drawImage(img, px, py, s.w * viewScale, s.h * viewScale);
		}
		document.getElementById("pageLabel")!.textContent = `${pageNo} / ${pageCount}`;
	}

	pageCv.addEventListener("click", async (ev) => {
		if (!hasInk) {
			status.innerHTML = `<span class="note-warn">${ui.needInk}</span>`;
			return;
		}
		const r = pageCv.getBoundingClientRect();
		const px = ((ev.clientX - r.left) / r.width) * pageCv.width;
		const py = ((ev.clientY - r.top) / r.height) * pageCv.height;
		// 签名图按「原始像素」缩放：只保留有笔迹的部分，避免大片空白
		const trimmed = trimPad();
		const dataUrl = trimmed.canvas.toDataURL("image/png");
		const pct = Number((document.getElementById("scale") as HTMLInputElement).value) / 100;
		const pw = (await opened!.doc.getPage(pageNo)).getViewport({ scale: 1 }).width;
		const w = pw * pct;
		const h = (trimmed.canvas.height / trimmed.canvas.width) * w;
		const x = px / viewScale - w / 2;
		const y = (pageCv.height - py) / viewScale - h / 2;
		placed.push({ page: pageNo, x, y, w, h, dataUrl });
		status.innerHTML = `${ui.placedOn} ${pageNo} · ${placed.length} ${ui.signatures}`;
		renderPage();
	});

	/** 裁掉签名板上的空白，只留笔迹范围（留 6px 余量） */
	function trimPad() {
		const { width: w, height: h } = pad;
		const data = pctx.getImageData(0, 0, w, h).data;
		let minX = w;
		let minY = h;
		let maxX = 0;
		let maxY = 0;
		for (let y = 0; y < h; y++) {
			for (let x = 0; x < w; x++) {
				if (data[(y * w + x) * 4 + 3] > 8) {
					if (x < minX) minX = x;
					if (x > maxX) maxX = x;
					if (y < minY) minY = y;
					if (y > maxY) maxY = y;
				}
			}
		}
		if (maxX <= minX || maxY <= minY) {
			return { canvas: pad, empty: true };
		}
		const pad6 = 6;
		minX = Math.max(0, minX - pad6);
		minY = Math.max(0, minY - pad6);
		maxX = Math.min(w - 1, maxX + pad6);
		maxY = Math.min(h - 1, maxY + pad6);
		const c = document.createElement("canvas");
		c.width = maxX - minX + 1;
		c.height = maxY - minY + 1;
		c.getContext("2d")!.drawImage(pad, minX, minY, c.width, c.height, 0, 0, c.width, c.height);
		return { canvas: c, empty: false };
	}

	document.getElementById("prev")!.addEventListener("click", () => {
		if (pageNo > 1) {
			pageNo--;
			renderPage();
		}
	});
	document.getElementById("next")!.addEventListener("click", () => {
		if (pageNo < pageCount) {
			pageNo++;
			renderPage();
		}
	});
	document.getElementById("undo")!.addEventListener("click", () => {
		placed.pop();
		status.textContent = "";
		renderPage();
	});

	fileIn.addEventListener("change", async () => {
		const f = fileIn.files?.[0];
		fileIn.value = "";
		if (!f) return;
		pdfName = f.name.replace(/\.pdf$/i, "") || "document";
		status.textContent = ui.loading;
		try {
			const bytes = new Uint8Array(await f.arrayBuffer());
			pdfBytes = bytes;
			const pdfjs = await import("../../lib/pdfjs.client");
			// openPdf 内部会复制一份给 pdf.js，原 bytes 留给后面 pdf-lib 用
			opened = await pdfjs.openPdf(bytes.buffer as ArrayBuffer);
			pageCount = opened.numPages;
			pageNo = 1;
			placed = [];
			dz.hidden = true;
			editor.hidden = false;
			await renderPage();
			status.textContent = "";
		} catch (err) {
			status.innerHTML = `<span class="note-warn">${escapeHtml(ui.failed)}: ${escapeHtml((err as Error).message)}</span>`;
		}
	});

	document.getElementById("reset")!.addEventListener("click", () => {
		pdfBytes = null;
		opened = null;
		placed = [];
		editor.hidden = true;
		dz.hidden = false;
		dz.classList.remove("is-compact");
		status.textContent = "";
		pctx.clearRect(0, 0, pad.width, pad.height);
		hasInk = false;
	});

	saveBtn.addEventListener("click", async () => {
		if (!pdfBytes) return;
		setBusy(saveBtn, ui.working);
		try {
			const { PDFDocument } = await import("pdf-lib");
			const doc = await PDFDocument.load(pdfBytes);
			const pages = doc.getPages();
			let n = 0;
			for (const s of placed) {
				const png = await doc.embedPng(s.dataUrl);
				pages[s.page - 1].drawImage(png, { x: s.x, y: s.y, width: s.w, height: s.h });
				n++;
			}
			const out = await doc.save();
			download(new Blob([out as BlobPart], { type: "application/pdf" }), `${pdfName}-signed.pdf`);
			status.innerHTML = `${ui.done} · ${n} ${ui.signatures} · ${formatBytes(out.length)}`;
		} catch (err) {
			status.innerHTML = `<span class="note-warn">${escapeHtml(ui.failed)}: ${escapeHtml((err as Error).message)}</span>`;
		}
		clearBusy(saveBtn);
	});
</script>
