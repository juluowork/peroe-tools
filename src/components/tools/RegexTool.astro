---
import type { ToolCopy } from "../../i18n";

interface Props {
	ui: ToolCopy["ui"];
}
const { ui } = Astro.props;
---

<script type="application/json" id="tool-ui" set:html={JSON.stringify(ui)} />

<div class="tool">
	<div class="options" style="align-items:flex-end">
		<label class="field" style="flex:1 1 340px"><span class="lbl">{ui.pattern}</span>
			<input id="pattern" type="text" placeholder="(\\w+)@(\\w+)\\.com" spellcheck="false" />
		</label>
		<label class="field" style="flex:0 0 auto"><span class="lbl">flags</span>
			<input id="flags" type="text" value="g" style="width:96px" spellcheck="false" />
		</label>
	</div>
	<div class="btns" style="margin-top:0">
		<button class="btn-ghost" id="flagG">g</button>
		<button class="btn-ghost" id="flagI">i</button>
		<button class="btn-ghost" id="flagM">m</button>
		<button class="btn-ghost" id="flagS">s</button>
		<button class="btn-ghost" id="flagU">u</button>
	</div>

	<div class="iogrid">
		<div>
			<span class="label">{ui.testText}</span>
			<textarea id="input" spellcheck="false" placeholder="hello@example.com, world@test.com"></textarea>
		</div>
		<div>
			<span class="label">{ui.matches}</span>
			<div id="preview" class="outbox" style="min-height:250px;padding:12px 14px;border:1px solid var(--line);border-radius:var(--radius-card);font:13px/1.7 ui-monospace,Consolas,monospace;white-space:pre-wrap;overflow:auto"></div>
		</div>
	</div>

	<div class="options">
		<label class="field" style="flex:1 1 320px"><span class="lbl">{ui.replaceWith}</span>
			<input id="replace" type="text" placeholder="$1 [at] $2" spellcheck="false" />
		</label>
	</div>
	<div class="btns">
		<button class="btn-primary" id="run">{ui.run}</button>
		<button class="btn-ghost" id="copy">{ui.copy}</button>
		<button class="btn-link" id="clear">{ui.clear}</button>
	</div>
	<p class="empty" id="status"></p>
	<div id="replaceOut" hidden style="margin-top:14px"></div>
</div>

<script>
	import { bindCopy } from "../../lib/devtools.client";
	import { escapeHtml } from "../../lib/imgtools.client";

	const ui = JSON.parse(document.getElementById("tool-ui")!.textContent || "{}");
	const patternIn = document.getElementById("pattern") as HTMLInputElement;
	const flagsIn = document.getElementById("flags") as HTMLInputElement;
	const input = document.getElementById("input") as HTMLTextAreaElement;
	const preview = document.getElementById("preview")!;
	const status = document.getElementById("status")!;
	const replaceIn = document.getElementById("replace") as HTMLInputElement;
	const replaceOut = document.getElementById("replaceOut")!;
	let lastReplace = "";

	// flags 快捷按钮
	for (const f of ["g", "i", "m", "s", "u"]) {
		document.getElementById(`flag${f.toUpperCase()}`)!.addEventListener("click", () => {
			const set = new Set(flagsIn.value.split(""));
			set.has(f) ? set.delete(f) : set.add(f);
			flagsIn.value = [...set].join("");
			run();
		});
}

	function run() {
		const source = input.value;
		const pattern = patternIn.value;
		if (!pattern) {
			status.textContent = ui.needPattern;
			preview.textContent = "";
			return;
		}
		let re: RegExp;
		try {
			re = new RegExp(pattern, flagsIn.value);
		} catch (err) {
			preview.textContent = "";
			status.innerHTML = `<span class="note-warn">${ui.badPattern}: ${escapeHtml((err as Error).message)}</span>`;
			return;
		}

		// 高亮预览：用 split 保留分隔符，避免 innerHTML 注入
		const matches: { text: string; index: number; groups: (string | undefined)[] }[] = [];
		if (flagsIn.value.includes("g")) {
			let m: RegExpExecArray | null;
			const probe = new RegExp(pattern, flagsIn.value);
			let guard = 0;
			while ((m = probe.exec(source)) !== null && guard++ < 5000) {
				matches.push({ text: m[0], index: m.index, groups: m.slice(1) });
				if (m[0] === "") probe.lastIndex++;
			}
		} else {
			const m = re.exec(source);
			if (m) matches.push({ text: m[0], index: m.index, groups: m.slice(1) });
		}

		let html = "";
		let cursor = 0;
		for (const m of matches) {
			html += escapeHtml(source.slice(cursor, m.index));
			html += `<mark style="background:#ffe58f;border-radius:3px;padding:0 1px">${escapeHtml(m.text) || "&#8203;"}</mark>`;
			cursor = m.index + m.text.length;
		}
		html += escapeHtml(source.slice(cursor));
		preview.innerHTML = html;

		// 替换预览
		if (replaceIn.value) {
			try {
				lastReplace = source.replace(new RegExp(pattern, flagsIn.value), replaceIn.value);
				replaceOut.innerHTML = `<span class="label">${ui.replaced}</span><div class="outbox" style="padding:12px 14px;border:1px solid var(--line);border-radius:var(--radius-card);font:13px/1.7 ui-monospace,Consolas,monospace;white-space:pre-wrap">${escapeHtml(lastReplace)}</div>`;
				replaceOut.hidden = false;
			} catch {
				replaceOut.hidden = true;
			}
		} else {
			replaceOut.hidden = true;
			lastReplace = "";
		}

		if (matches.length === 0) {
			status.innerHTML = `<span class="note-warn">${ui.noMatch}</span>`;
		} else {
			const details = matches
				.slice(0, 200)
				.map((m, i) => `<div class="hashrow"><span class="algo">#${i + 1}</span><code>${escapeHtml(m.text)}${
					m.groups.length ? `  →  ${m.groups.map((g, gi) => `$${gi + 1}=${escapeHtml(g ?? "")}`).join("  ")}` : ""
				}</code><span class="small muted">@${m.index}</span></div>`)
				.join("");
			const box = document.createElement("div");
			box.className = "card";
			box.style.marginTop = "12px";
			box.innerHTML = details;
			status.innerHTML = `${matches.length} ${ui.matchCount}`;
			status.appendChild(box);
		}
	}

	document.getElementById("run")!.addEventListener("click", run);
	document.getElementById("clear")!.addEventListener("click", () => {
	input.value = "";
	preview.innerHTML = "";
	status.textContent = "";
	replaceOut.hidden = true;
});
	bindCopy(document.getElementById("copy") as HTMLButtonElement, () => lastReplace || input.value, ui.copied, ui.copy);
	let timer: number | undefined;
	for (const el of [patternIn, flagsIn, input, replaceIn]) {
		el.addEventListener("input", () => {
			window.clearTimeout(timer);
			timer = window.setTimeout(run, 300);
		});
	}
</script>
