---
import type { ToolCopy } from "../../i18n";
import DropZone from "../DropZone.astro";

interface Props {
	ui: ToolCopy["ui"];
	privacy: string;
}
const { ui, privacy } = Astro.props;
---

<script type="application/json" id="tool-ui" set:html={JSON.stringify(ui)} />

<div class="tool">
	<DropZone id="dz" title={ui.dropzone} sub={ui.orDrop} privacy={privacy} />
	<input id="file" type="file" accept="image/*" multiple hidden />

	<ul class="filelist" id="list"></ul>

	<div class="options" id="options" hidden>
		<label class="field"><span class="lbl">{ui.pageSize}</span>
			<select id="size">
				<option value="auto">{ui.sizeAuto}</option>
				<option value="a4">A4</option>
				<option value="letter">Letter</option>
			</select>
		</label>
		<label class="field"><span class="lbl">{ui.margin}</span>
			<input id="margin" type="number" min="0" max="72" step="2" value="0" />
		</label>
		<label class="field"><span class="lbl">{ui.filename}</span>
			<input id="fname" type="text" value="document" />
		</label>
	</div>

	<div class="btns" id="actions" hidden>
		<button class="btn-primary" id="run">{ui.run}</button>
		<button class="btn-ghost" id="add">{ui.addMore}</button>
		<button class="btn-link" id="reset">{ui.startOver}</button>
	</div>
	<p class="empty" id="status"></p>
</div>

<script>
	import {
		bindDropZone, clearBusy, escapeHtml, formatBytes, loadImage, opButton, renderRow, setBusy,
	} from "../../lib/imgtools.client";

	const ui = JSON.parse(document.getElementById("tool-ui")!.textContent || "{}");
	const dz = document.getElementById("dz")!;
	const input = document.getElementById("file") as HTMLInputElement;
	const list = document.getElementById("list")!;
	const options = document.getElementById("options")!;
	const actions = document.getElementById("actions")!;
	const runBtn = document.getElementById("run") as HTMLButtonElement;
	const status = document.getElementById("status")!;
	const sizeSel = document.getElementById("size") as HTMLSelectElement;
	const marginIn = document.getElementById("margin") as HTMLInputElement;
	const fnameIn = document.getElementById("fname") as HTMLInputElement;
	let files: File[] = [];

	function render() {
		list.innerHTML = "";
		files.forEach((file, i) => {
			const li = renderRow({
				name: `${i + 1}. ${file.name}`,
				sizeText: formatBytes(file.size),
				thumbUrl: URL.createObjectURL(file),
			});
			const ops = li.querySelector(".ops")!;
			const up = opButton("↑", "icon", () => {
				[files[i - 1], files[i]] = [files[i], files[i - 1]];
				render();
			});
			up.disabled = i === 0;
			const down = opButton("↓", "icon", () => {
				[files[i + 1], files[i]] = [files[i], files[i + 1]];
				render();
			});
			down.disabled = i === files.length - 1;
			const del = opButton("×", "danger", () => {
				files.splice(i, 1);
				render();
			});
			ops.append(up, down, del);
			list.appendChild(li);
		});
		options.hidden = files.length === 0;
		actions.hidden = files.length === 0;
	}
	bindDropZone(dz, input, (picked) => {
		files = files.concat(picked.filter((f) => f.type.startsWith("image/")));
		dz.classList.add("is-compact");
		render();
	});
	document.getElementById("add")!.addEventListener("click", () => input.click());
	document.getElementById("reset")!.addEventListener("click", () => {
		files = [];
		status.textContent = "";
		dz.classList.remove("is-compact");
		render();
	});

	runBtn.addEventListener("click", async () => {
	setBusy(runBtn, ui.generating);
	status.textContent = "";
	try {
		// 按需加载 pdf-lib（约 400KB）：只有真正点生成时才下载
		const { PDFDocument } = await import("pdf-lib");
		const pdf = await PDFDocument.create();
		const margin = Math.max(0, Number(marginIn.value || 0));
		const mode = sizeSel.value;
		const PAGE: Record<string, [number, number]> = { a4: [595.28, 841.89], letter: [612, 792] };
		for (const file of files) {
			const img = await loadImage(file);
			const bytes = new Uint8Array(await file.arrayBuffer());
			let embedded: Awaited<ReturnType<typeof pdf.embedPng>>;
			try {
				embedded = file.type === "image/png" ? await pdf.embedPng(bytes) : await pdf.embedJpg(bytes);
			} catch {
				const canvas = document.createElement("canvas");
				canvas.width = img.width;
				canvas.height = img.height;
				canvas.getContext("2d")!.drawImage(img.bitmap, 0, 0);
				const pngBlob: Blob = await new Promise((res) => canvas.toBlob((b) => res(b!), "image/png"));
				embedded = await pdf.embedPng(new Uint8Array(await pngBlob.arrayBuffer()));
			}
			let pageW: number;
			let pageH: number;
			if (mode === "auto") {
				pageW = embedded.width + margin * 2;
				pageH = embedded.height + margin * 2;
			} else {
				[pageW, pageH] = PAGE[mode];
			}
			const page = pdf.addPage([pageW, pageH]);
			const scale = Math.min((pageW - margin * 2) / embedded.width, (pageH - margin * 2) / embedded.height);
			const dw = embedded.width * scale;
			const dh = embedded.height * scale;
			page.drawImage(embedded, { x: (pageW - dw) / 2, y: (pageH - dh) / 2, width: dw, height: dh });
			img.bitmap.close();
		}
		const out = await pdf.save();
		const blob = new Blob([out as unknown as BlobPart], { type: "application/pdf" });
		status.innerHTML = `${ui.generated}: <b>${formatBytes(blob.size)}</b> · ${files.length} ${ui.pages}`;
		const btn = opButton(ui.download, "primary", () => {
			const url = URL.createObjectURL(blob);
			const a = document.createElement("a");
			a.href = url;
			a.download = `${fnameIn.value || "document"}.pdf`;
			a.click();
			setTimeout(() => URL.revokeObjectURL(url), 4000);
		});
		const restart = opButton(ui.startOver, "icon", () => {
			files = [];
			status.textContent = "";
			dz.classList.remove("is-compact");
			render();
		});
		const bar = document.createElement("div");
		bar.className = "btns";
		bar.append(btn, restart);
		status.appendChild(bar);
	} catch (err) {
		status.innerHTML = `<span class="note-warn">${escapeHtml(ui.failed)}: ${escapeHtml((err as Error).message)}</span>`;
	}
	clearBusy(runBtn);
});
</script>
