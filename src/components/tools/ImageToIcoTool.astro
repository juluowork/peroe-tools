---
import type { ToolCopy } from "../../i18n";
import DropZone from "../DropZone.astro";

interface Props {
	ui: ToolCopy["ui"];
	privacy: string;
}
const { ui, privacy } = Astro.props;
---

<script type="application/json" id="tool-ui" set:html={JSON.stringify(ui)} />

<div class="tool">
	<DropZone id="dz" title={ui.dropzone} sub={ui.orDrop} privacy={privacy} />
	<input id="file" type="file" accept="image/*" multiple hidden />

	<ul class="filelist" id="list"></ul>

	<div class="options" id="options" hidden>
		<label class="field"><span class="lbl">{ui.sizes}</span>
			<select id="sizes">
				<option value="16,32,48">{ui.sizesSmall}</option>
				<option value="16,32,48,64,128,256" selected>{ui.sizesAll}</option>
				<option value="32,64,128">{ui.sizesMid}</option>
				<option value="256">{ui.sizesOne}</option>
			</select>
		</label>
		<label class="field"><span class="lbl">{ui.fit}</span>
			<select id="fit">
				<option value="contain">{ui.fitContain}</option>
				<option value="cover">{ui.fitCover}</option>
			</select>
		</label>
	</div>

	<div class="btns" id="actions" hidden>
		<button class="btn-primary" id="run">{ui.run}</button>
		<button class="btn-ghost" id="add">{ui.addMore}</button>
		<button class="btn-link" id="reset">{ui.startOver}</button>
	</div>
	<p class="empty" id="status"></p>
</div>

<script>
	import { bindDropZone, clearBusy, download, escapeHtml, formatBytes, loadImage, opButton, renderRow, replaceExt, setBusy } from "../../lib/imgtools.client";

	const ui = JSON.parse(document.getElementById("tool-ui")!.textContent || "{}");
	const dz = document.getElementById("dz")!;
	const input = document.getElementById("file") as HTMLInputElement;
	const list = document.getElementById("list")!;
	const options = document.getElementById("options")!;
	const actions = document.getElementById("actions")!;
	const runBtn = document.getElementById("run") as HTMLButtonElement;
	const status = document.getElementById("status")!;
	let files: File[] = [];

	function renderBase() {
		list.innerHTML = "";
		files.forEach((f) => list.appendChild(renderRow({ name: f.name, sizeText: formatBytes(f.size), thumbUrl: URL.createObjectURL(f) })));
		options.hidden = files.length === 0;
		actions.hidden = files.length === 0;
	}
	bindDropZone(dz, input, (picked) => {
		files = files.concat(picked.filter((f) => f.type.startsWith("image/")));
		dz.classList.add("is-compact");
		renderBase();
	});
	document.getElementById("add")!.addEventListener("click", () => input.click());
	document.getElementById("reset")!.addEventListener("click", () => {
		files = [];
		dz.classList.remove("is-compact");
		renderBase();
});

	/** 生成 ICO 容器：ICONDIR + 每张图的 ICONDIRENTRY + PNG 数据（Vista 起支持 PNG 条目） */
	function buildIco(entries: { size: number; data: Uint8Array }[]): Blob {
		const header = new Uint8Array(6 + 16 * entries.length);
		const dv = new DataView(header.buffer);
		dv.setUint16(0, 0, true);
		dv.setUint16(2, 1, true);
		dv.setUint16(4, entries.length, true);
		let offset = header.length;
		entries.forEach((p, i) => {
			const e = 6 + i * 16;
			header[e] = p.size >= 256 ? 0 : p.size;
			header[e + 1] = p.size >= 256 ? 0 : p.size;
			header[e + 2] = 0;
			header[e + 3] = 0;
			dv.setUint16(e + 4, 1, true);
			dv.setUint16(e + 6, 32, true);
			dv.setUint32(e + 8, p.data.length, true);
			dv.setUint32(e + 12, offset, true);
			offset += p.data.length;
		});
		const parts: BlobPart[] = [header];
		entries.forEach((p) => parts.push(p.data));
		return new Blob(parts, { type: "image/x-icon" });
	}

	async function canvasOf(img: Awaited<ReturnType<typeof loadImage>>, size: number, fit: string): Promise<HTMLCanvasElement> {
		const canvas = document.createElement("canvas");
		canvas.width = canvas.height = size;
		const ctx = canvas.getContext("2d")!;
		ctx.imageSmoothingQuality = "high";
		if (fit === "cover") {
			const scale = Math.max(size / img.width, size / img.height);
			const w = img.width * scale;
			const h = img.height * scale;
			ctx.drawImage(img.bitmap, (size - w) / 2, (size - h) / 2, w, h);
		} else {
			const scale = Math.min(size / img.width, size / img.height);
			const w = img.width * scale;
			const h = img.height * scale;
			ctx.drawImage(img.bitmap, (size - w) / 2, (size - h) / 2, w, h);
		}
		return canvas;
	}

	runBtn.addEventListener("click", async () => {
	if (files.length === 0) return;
	renderBase();
	const rows = [...list.children] as HTMLLIElement[];
	const sizes = (document.getElementById("sizes") as HTMLSelectElement).value.split(",").map(Number);
	const fit = (document.getElementById("fit") as HTMLSelectElement).value;
	for (let i = 0; i < files.length; i++) {
		const file = files[i];
		const li = rows[i];
		setBusy(runBtn, `${ui.working} ${i + 1}/${files.length}`);
		try {
			const img = await loadImage(file);
			const entries: { size: number; data: Uint8Array }[] = [];
			for (const size of sizes) {
				const canvas = await canvasOf(img, size, fit);
				const blob: Blob = await new Promise((res, rej) => canvas.toBlob((b) => (b ? res(b) : rej(new Error("png failed"))), "image/png"));
				entries.push({ size, data: new Uint8Array(await blob.arrayBuffer()) });
			}
			const ico = buildIco(entries);
			const outName = replaceExt(file.name, "ico");
			li.querySelector(".thumb")!.replaceWith(Object.assign(document.createElement("img"), { className: "thumb", src: (await canvasOf(img, 64, fit)).toDataURL("image/png") }));
			li.querySelector(".fsize")!.innerHTML = `${formatBytes(file.size)} → <b>${formatBytes(ico.size)}</b> · ${sizes.join("/")} px`;
			li.querySelector(".ops")!.appendChild(opButton(ui.download, "primary", () => download(ico, outName)));
			img.bitmap.close();
		} catch (err) {
			li.querySelector(".fsize")!.innerHTML = `<span class="note-warn">${escapeHtml(ui.failed)}: ${escapeHtml((err as Error).message)}</span>`;
		}
	}
	clearBusy(runBtn);
	status.textContent = ui.done;
});
</script>
