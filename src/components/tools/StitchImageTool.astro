---
import type { ToolCopy } from "../../i18n";
import DropZone from "../DropZone.astro";

interface Props {
	ui: ToolCopy["ui"];
	privacy: string;
}
const { ui, privacy } = Astro.props;
---

<script type="application/json" id="tool-ui" set:html={JSON.stringify(ui)} />

<div class="tool">
	<DropZone id="dz" title={ui.dropzone} sub={ui.orDrop} privacy={privacy} />
	<input id="file" type="file" accept="image/*" multiple hidden />

	<ul class="filelist" id="list"></ul>

	<div class="options" id="options" hidden>
		<label class="field"><span class="lbl">{ui.direction}</span>
			<select id="dir">
				<option value="v">{ui.dirVertical}</option>
				<option value="h">{ui.dirHorizontal}</option>
			</select>
		</label>
		<label class="field"><span class="lbl">{ui.gap} <b id="gapv">0</b>px</span>
			<input id="gap" type="range" min="0" max="80" value="0" />
		</label>
		<label class="field"><span class="lbl">{ui.bg}</span>
			<select id="bg">
				<option value="transparent">{ui.bgTransparent}</option>
				<option value="#ffffff">White</option>
				<option value="#f1f5f9">Light grey</option>
				<option value="#000000">Black</option>
			</select>
		</label>
		<label class="field"><span class="lbl">{ui.uniform}</span>
			<select id="uniform">
				<option value="0">{ui.uniformOff}</option>
				<option value="1">{ui.uniformOn}</option>
			</select>
		</label>
		<label class="field"><span class="lbl">{ui.padding} <b id="padv">0</b>px</span>
			<input id="padding" type="range" min="0" max="120" value="0" />
		</label>
		<label class="field"><span class="lbl">{ui.format}</span>
			<select id="format">
				<option value="image/png">PNG</option>
				<option value="image/jpeg">JPG</option>
			</select>
		</label>
	</div>

	<div class="btns" id="actions" hidden>
		<button class="btn-primary" id="run">{ui.run}</button>
		<button class="btn-ghost" id="add">{ui.addMore}</button>
		<button class="btn-ghost" id="reverse">{ui.reverse}</button>
		<button class="btn-link" id="reset">{ui.startOver}</button>
	</div>
	<p class="empty" id="status"></p>
	<div id="preview" hidden style="margin-top:14px"></div>
</div>

<script>
	import { bindDropZone, clearBusy, download, escapeHtml, formatBytes, loadImage, opButton, renderRow, setBusy } from "../../lib/imgtools.client";

	const ui = JSON.parse(document.getElementById("tool-ui")!.textContent || "{}");
	const dz = document.getElementById("dz")!;
	const input = document.getElementById("file") as HTMLInputElement;
	const list = document.getElementById("list")!;
	const options = document.getElementById("options")!;
	const actions = document.getElementById("actions")!;
	const runBtn = document.getElementById("run") as HTMLButtonElement;
	const status = document.getElementById("status")!;
	const preview = document.getElementById("preview")!;
	const gapIn = document.getElementById("gap") as HTMLInputElement;
	const paddingIn = document.getElementById("padding") as HTMLInputElement;
	const gapv = document.getElementById("gapv")!;
	const padv = document.getElementById("padv")!;
	gapIn.addEventListener("input", () => (gapv.textContent = gapIn.value));
	paddingIn.addEventListener("input", () => (padv.textContent = paddingIn.value));

	let files: File[] = [];

	function renderBase() {
		list.innerHTML = "";
		files.forEach((f, i) => {
			const li = renderRow({ name: `${i + 1}. ${f.name}`, sizeText: formatBytes(f.size), thumbUrl: URL.createObjectURL(f) });
			const ops = li.querySelector(".ops")!;
			const up = opButton("↑", "icon", () => {
				[files[i - 1], files[i]] = [files[i], files[i - 1]];
				renderBase();
			});
			up.disabled = i === 0;
			const down = opButton("↓", "icon", () => {
				[files[i + 1], files[i]] = [files[i], files[i + 1]];
				renderBase();
			});
			down.disabled = i === files.length - 1;
			ops.append(up, down, opButton(ui.remove, "danger", () => {
				files.splice(i, 1);
				renderBase();
			}));
			list.appendChild(li);
		});
		const n = files.length;
		options.hidden = n === 0;
		actions.hidden = n === 0;
		runBtn.disabled = n < 2;
	}

	bindDropZone(dz, input, (picked) => {
		files = files.concat(picked.filter((f) => f.type.startsWith("image/")));
		dz.classList.add("is-compact");
		renderBase();
	});
	document.getElementById("add")!.addEventListener("click", () => input.click());
	document.getElementById("reverse")!.addEventListener("click", () => {
		files.reverse();
		renderBase();
	});
	document.getElementById("reset")!.addEventListener("click", () => {
		files = [];
		list.innerHTML = "";
		preview.hidden = true;
		status.textContent = "";
		dz.classList.remove("is-compact");
		renderBase();
	});

	runBtn.addEventListener("click", async () => {
		if (files.length < 2) return;
		setBusy(runBtn, ui.working);
		status.textContent = "";
		preview.hidden = true;
		try {
			const dir = (document.getElementById("dir") as HTMLSelectElement).value;
			const gap = Number(gapIn.value);
			const pad = Number(paddingIn.value);
			const bg = (document.getElementById("bg") as HTMLSelectElement).value;
			const uniform = (document.getElementById("uniform") as HTMLSelectElement).value === "1";
			const mime = (document.getElementById("format") as HTMLSelectElement).value;

			// 先把每张图画成独立的 canvas（顺带释放 ImageBitmap）
			const parts: HTMLCanvasElement[] = [];
			for (const f of files) {
				const img = await loadImage(f);
				const c = document.createElement("canvas");
				c.width = img.width;
				c.height = img.height;
				c.getContext("2d")!.drawImage(img.bitmap, 0, 0);
				img.bitmap.close();
				parts.push(c);
			}

			// 「统一宽度/高度」：以最长边为准等比缩放，聊天记录截图宽度不一致时最有用
			if (uniform) {
				if (dir === "v") {
					const target = Math.max(...parts.map((p) => p.width));
					for (const p of parts) {
						if (p.width === target) continue;
						const scaled = document.createElement("canvas");
						scaled.width = target;
						scaled.height = Math.round((p.height * target) / p.width);
						scaled.getContext("2d")!.drawImage(p, 0, 0, scaled.width, scaled.height);
						p.width = scaled.width;
						p.height = scaled.height;
						p.getContext("2d")!.drawImage(scaled, 0, 0);
					}
				} else {
					const target = Math.max(...parts.map((p) => p.height));
					for (const p of parts) {
						if (p.height === target) continue;
						const scaled = document.createElement("canvas");
						scaled.height = target;
						scaled.width = Math.round((p.width * target) / p.height);
						scaled.getContext("2d")!.drawImage(p, 0, 0, scaled.width, scaled.height);
						p.width = scaled.width;
						p.height = scaled.height;
						p.getContext("2d")!.drawImage(scaled, 0, 0);
					}
				}
			}

			const totalGap = gap * (parts.length - 1);
			const out = document.createElement("canvas");
			if (dir === "v") {
				out.width = Math.max(...parts.map((p) => p.width)) + pad * 2;
				out.height = parts.reduce((s, p) => s + p.height, 0) + totalGap + pad * 2;
			} else {
				out.width = parts.reduce((s, p) => s + p.width, 0) + totalGap + pad * 2;
				out.height = Math.max(...parts.map((p) => p.height)) + pad * 2;
			}
			const g = out.getContext("2d")!;
			if (bg !== "transparent") {
				g.fillStyle = bg;
				g.fillRect(0, 0, out.width, out.height);
			}
			let cursor = pad;
			for (const p of parts) {
				if (dir === "v") {
					g.drawImage(p, Math.round((out.width - p.width) / 2), cursor);
					cursor += p.height + gap;
				} else {
					g.drawImage(p, cursor, Math.round((out.height - p.height) / 2));
					cursor += p.width + gap;
				}
			}

			const blob: Blob = await new Promise((res, rej) =>
				out.toBlob((b) => (b ? res(b) : rej(new Error("export failed"))), mime, 0.94),
			);
			const ext = mime === "image/jpeg" ? "jpg" : "png";
			const name = `stitched-${out.width}x${out.height}.${ext}`;

			preview.innerHTML = "";
			const bar = document.createElement("div");
			bar.className = "btns";
			bar.append(opButton(ui.download, "primary", () => download(blob, name)));
			preview.append(bar);
			const card = document.createElement("div");
			card.className = "card";
			card.style.marginTop = "12px";
			const thumb = document.createElement("img");
			thumb.src = out.toDataURL("image/jpeg", 0.6);
			thumb.alt = name;
			thumb.style.cssText = "display:block;max-width:100%;max-height:520px;margin:0 auto;border:1px solid var(--line);border-radius:10px";
			card.append(thumb);
			preview.append(card);
			preview.hidden = false;
			status.innerHTML = `${ui.done} · ${files.length} ${ui.images} → <b>${out.width}×${out.height}</b> px · ${formatBytes(blob.size)}`;
		} catch (err) {
			status.innerHTML = `<span class="note-warn">${escapeHtml(ui.failed)}: ${escapeHtml((err as Error).message)}</span>`;
		}
		clearBusy(runBtn);
	});
</script>
