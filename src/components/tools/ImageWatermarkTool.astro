---
import type { ToolCopy } from "../../i18n";
import DropZone from "../DropZone.astro";

interface Props {
	ui: ToolCopy["ui"];
	privacy: string;
}
const { ui, privacy } = Astro.props;
---

<script type="application/json" id="tool-ui" set:html={JSON.stringify(ui)} />

<div class="tool">
	<DropZone id="dz" title={ui.dropzone} sub={ui.orDrop} privacy={privacy} />
	<input id="file" type="file" accept="image/*" multiple hidden />

	<ul class="filelist" id="list"></ul>

	<div class="options" id="options" hidden>
		<label class="field"><span class="lbl">{ui.text}</span>
			<input id="text" type="text" value="© peroe" />
		</label>
		<label class="field"><span class="lbl">{ui.position}</span>
			<select id="pos">
				<option value="br">{ui.posBR}</option>
				<option value="bl">{ui.posBL}</option>
				<option value="tr">{ui.posTR}</option>
				<option value="tl">{ui.posTL}</option>
				<option value="center">{ui.posCenter}</option>
				<option value="tile">{ui.posTile}</option>
			</select>
		</label>
		<label class="field"><span class="lbl">{ui.size} <b id="szv">4</b>%</span>
			<input id="size" type="range" min="2" max="20" value="4" />
		</label>
		<label class="field"><span class="lbl">{ui.opacity} <b id="opv">70%</b></span>
			<input id="opacity" type="range" min="10" max="100" value="70" />
		</label>
		<label class="field"><span class="lbl">{ui.color}</span>
			<select id="color">
				<option value="#ffffff">White</option>
				<option value="#000000">Black</option>
				<option value="#00bb88">Green</option>
				<option value="#dc2626">Red</option>
			</select>
		</label>
		<label class="field"><span class="lbl">{ui.shadow}</span>
			<select id="shadow">
				<option value="1">{ui.shadowOn}</option>
				<option value="0">{ui.shadowOff}</option>
			</select>
		</label>
	</div>

	<div class="btns" id="actions" hidden>
		<button class="btn-primary" id="run">{ui.run}</button>
		<button class="btn-ghost" id="add">{ui.addMore}</button>
		<button class="btn-link" id="reset">{ui.startOver}</button>
	</div>
	<p class="empty" id="status"></p>
</div>

<script>
	import { bindDropZone, clearBusy, download, escapeHtml, formatBytes, loadImage, opButton, renderRow, replaceExt, setBusy } from "../../lib/imgtools.client";

	const ui = JSON.parse(document.getElementById("tool-ui")!.textContent || "{}");
	const dz = document.getElementById("dz")!;
	const input = document.getElementById("file") as HTMLInputElement;
	const list = document.getElementById("list")!;
	const options = document.getElementById("options")!;
	const actions = document.getElementById("actions")!;
	const runBtn = document.getElementById("run") as HTMLButtonElement;
	const status = document.getElementById("status")!;
	const szv = document.getElementById("szv")!;
	const opv = document.getElementById("opv")!;
	let files: File[] = [];

	const sizeIn = document.getElementById("size") as HTMLInputElement;
	const opacityIn = document.getElementById("opacity") as HTMLInputElement;
	sizeIn.addEventListener("input", () => (szv.textContent = sizeIn.value));
	opacityIn.addEventListener("input", () => (opv.textContent = `${opacityIn.value}%`));

	function renderBase() {
		list.innerHTML = "";
		files.forEach((f) => list.appendChild(renderRow({ name: f.name, sizeText: formatBytes(f.size), thumbUrl: URL.createObjectURL(f) })));
		options.hidden = files.length === 0;
		actions.hidden = files.length === 0;
	}
	bindDropZone(dz, input, (picked) => {
		files = files.concat(picked.filter((f) => f.type.startsWith("image/")));
		dz.classList.add("is-compact");
		renderBase();
	});
	document.getElementById("add")!.addEventListener("click", () => input.click());
	document.getElementById("reset")!.addEventListener("click", () => {
		files = [];
		dz.classList.remove("is-compact");
		renderBase();
});

	function drawWatermark(canvas: HTMLCanvasElement, text: string, pos: string, pct: number, alpha: number, color: string, shadow: boolean) {
		const ctx = canvas.getContext("2d")!;
		const fontPx = Math.max(10, Math.round((Math.min(canvas.width, canvas.height) * pct) / 100));
		const font = `600 ${fontPx}px system-ui, "PingFang SC", "Microsoft YaHei", sans-serif`;
		ctx.save();
		ctx.font = font;
		ctx.globalAlpha = alpha;
		ctx.fillStyle = color;
		if (shadow) {
			ctx.shadowColor = "rgba(0,0,0,.45)";
			ctx.shadowBlur = Math.max(2, fontPx * 0.12);
			ctx.shadowOffsetY = 1;
		}
		const pad = Math.round(fontPx * 0.6);
		const tw = ctx.measureText(text).width;
		if (pos === "tile") {
			ctx.translate(canvas.width / 2, canvas.height / 2);
			ctx.rotate(-Math.PI / 6);
			ctx.translate(-canvas.width / 2, -canvas.height / 2);
			const stepX = tw + fontPx * 3;
			const stepY = fontPx * 4;
			for (let y = -canvas.height; y < canvas.height * 2; y += stepY) {
				for (let x = -canvas.width; x < canvas.width * 2; x += stepX) ctx.fillText(text, x, y);
			}
		} else {
			const x = pos.endsWith("l") ? pad : pos.endsWith("r") ? canvas.width - tw - pad : (canvas.width - tw) / 2;
			const y = pos.startsWith("t") ? fontPx + pad : pos.startsWith("b") ? canvas.height - pad : (canvas.height + fontPx) / 2;
			ctx.fillText(text, x, y);
		}
		ctx.restore();
	}

	runBtn.addEventListener("click", async () => {
	if (files.length === 0) return;
	renderBase();
	const rows = [...list.children] as HTMLLIElement[];
	const text = (document.getElementById("text") as HTMLInputElement).value || "©";
	const pos = (document.getElementById("pos") as HTMLSelectElement).value;
	const pct = Number(sizeIn.value);
	const alpha = Number(opacityIn.value) / 100;
	const color = (document.getElementById("color") as HTMLSelectElement).value;
	const shadow = (document.getElementById("shadow") as HTMLSelectElement).value === "1";
	for (let i = 0; i < files.length; i++) {
		const file = files[i];
		const li = rows[i];
		setBusy(runBtn, `${ui.working} ${i + 1}/${files.length}`);
		try {
			const img = await loadImage(file);
			const canvas = document.createElement("canvas");
			canvas.width = img.width;
			canvas.height = img.height;
			canvas.getContext("2d")!.drawImage(img.bitmap, 0, 0);
			drawWatermark(canvas, text, pos, pct, alpha, color, shadow);
			const mime = file.type === "image/png" || file.type === "image/webp" ? file.type : "image/jpeg";
			const blob: Blob = await new Promise((res, rej) => canvas.toBlob((b) => (b ? res(b) : rej(new Error("export failed"))), mime, 0.92));
			const outName = replaceExt(file.name, mime === "image/jpeg" ? "jpg" : mime === "image/webp" ? "webp" : "png");
			li.querySelector(".thumb")!.replaceWith(Object.assign(document.createElement("img"), { className: "thumb", src: canvas.toDataURL("image/jpeg", 0.5) }));
			li.querySelector(".fsize")!.innerHTML = `${formatBytes(file.size)} → <b>${formatBytes(blob.size)}</b>`;
			li.querySelector(".ops")!.appendChild(opButton(ui.download, "primary", () => download(blob, outName)));
			img.bitmap.close();
		} catch (err) {
			li.querySelector(".fsize")!.innerHTML = `<span class="note-warn">${escapeHtml(ui.failed)}: ${escapeHtml((err as Error).message)}</span>`;
		}
	}
	clearBusy(runBtn);
	status.textContent = ui.done;
});
</script>
