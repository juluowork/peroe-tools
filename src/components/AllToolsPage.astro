---
import type { Locale, SiteCopy, ToolCopy } from "../i18n";
import { categoryPath, localePath, toolPath, toolsByCategory, toolIcon } from "../i18n";
import Base from "../layouts/Base.astro";
import Icon from "./Icon.astro";
import ToolShell from "./ToolShell.astro";

interface Props {
	locale: Locale;
	site: SiteCopy;
	tools: ToolCopy[];
}
const { locale, site, tools } = Astro.props;
const groups = toolsByCategory(locale);
const origin = "https://tools.juluo.work";

const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "CollectionPage",
		name: site.toolsPageTitle,
		url: origin + localePath(locale, "/tools/"),
		description: site.toolsPageDescription,
	},
	{
		"@context": "https://schema.org",
		"@type": "ItemList",
		itemListElement: tools.map((t, i) => ({
			"@type": "ListItem",
			position: i + 1,
			name: t.nav,
			url: origin + toolPath(locale, t),
		})),
	},
];
---

<Base
	locale={locale}
	site={site}
	tools={tools}
	title={site.toolsPageTitle}
	description={site.toolsPageDescription}
	path="/tools/"
	jsonLd={jsonLd}
>
	<div class="tool-head">
		<div class="crumbs">
			<a href={localePath(locale, "/")}><Icon name="home" size={14} /></a>
			<span>/</span><span>{site.navAllTools}</span>
		</div>
		<h1>{site.toolsPageH1}</h1>
		<p class="lead">{site.toolsPageLead}</p>
		<span class="pill"><Icon name="lock" size={14} /> {site.footerNote}</span>
	</div>

	<div class="searchbar">
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
			<circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
		</svg>
		<input
			type="search"
			id="tool-search"
			placeholder={site.searchPlaceholder}
			autocomplete="off"
			aria-label={site.searchPlaceholder}
		/>
	</div>

	<ToolShell locale={locale} site={site} tools={tools} active="all">
		<div id="search-empty" class="empty" hidden>{site.searchEmpty}</div>

			{groups.map((g) => (
			<section class="cat-section" id={g.category.id} data-cat={g.category.id}>
				<div class="section-head">
					<h2><a href={categoryPath(locale, g.category.id)}>{g.category.name}</a></h2>
					<span class="small muted">{g.category.blurb}</span>
					<a class="btn-link" href={categoryPath(locale, g.category.id)} style="margin-left:auto">
						{locale === "en" ? "Category page" : "分类页"} →
					</a>
				</div>
				<div class="grid">
					{g.tools.map((t) => (
						<a
							class="card"
							href={toolPath(locale, t)}
							data-search={`${t.nav} ${t.blurb} ${t.keywords.join(" ")}`.toLowerCase()}
						>
							<div class="ico"><Icon name={toolIcon(t.slug)} size={32} /></div>
							<h3>{t.nav}</h3>
							<p>{t.blurb}</p>
							<div class="cat">{categoryPath(locale, g.category.id) && g.category.name}</div>
						</a>
					))}
				</div>
			</section>
		))}

		<section class="prose">
			<h2>{locale === "en" ? "More tools are on the way" : "还有更多工具在路上"}</h2>
			<p>
				{locale === "en"
					? "This site is built to grow: the navigation groups tools by category, so image, PDF, developer, text and network utilities all stay findable as the list gets longer. New tools appear here as soon as they ship — nothing to install, and still no uploads."
					: "这个站点是奔着「变多」设计的：导航按分类组织，等图片、PDF、开发、文本、网络这些工具都堆起来时依然找得到。新工具一上线就会出现在这里，不用安装任何东西，也依然不上传文件。"}
			</p>
			<div class="ad-slot" data-ad-slot="tools-mid"></div>
		</section>
	</ToolShell>

</Base>

<script>
	const input = document.getElementById("tool-search") as HTMLInputElement | null;
	const empty = document.getElementById("search-empty")!;
	if (input) {
		const cards = [...document.querySelectorAll<HTMLAnchorElement>(".card[data-search]")];
		const sections = [...document.querySelectorAll<HTMLElement>(".cat-section")];
		const norm = (s: string) => s.toLowerCase().trim();
		function apply() {
			const q = norm(input!.value);
			let total = 0;
			for (const sec of sections) {
				let visible = 0;
				for (const card of sec.querySelectorAll<HTMLAnchorElement>(".card")) {
					const hit = !q || (card.dataset.search ?? "").includes(q);
					card.style.display = hit ? "" : "none";
					if (hit) visible++;
				}
				sec.hidden = visible === 0;
				total += visible;
			}
			empty.hidden = total > 0;
		}
		input.addEventListener("input", apply);
		// 支持 /tools/?q=pdf 这类直达链接与 ⌘K/Ctrl+K 聚焦
		const preset = new URLSearchParams(location.search).get("q");
		if (preset) {
			input.value = preset;
			apply();
		}
		document.addEventListener("keydown", (e) => {
			if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
				e.preventDefault();
				input.focus();
				input.select();
			}
		});
	}
</script>
