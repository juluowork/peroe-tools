---
import type { Locale, SiteCopy, ToolCopy } from "../i18n";
import { categoryPath, localePath, toolIcon, toolPath, toolsByCategory } from "../i18n";
import Base from "../layouts/Base.astro";
import Icon from "./Icon.astro";
import ToolShell from "./ToolShell.astro";

interface Props {
	locale: Locale;
	site: SiteCopy;
	tools: ToolCopy[];
}
const { locale, site, tools } = Astro.props;
const groups = toolsByCategory(locale);
const origin = "https://tools.juluo.work";
const n = (x: number) => `${x} ${site.categoriesToolsLabel}`;

const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "CollectionPage",
		name: site.categoriesPageTitle,
		url: origin + localePath(locale, "/categories/"),
		description: site.categoriesPageDescription,
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{ "@type": "ListItem", position: 1, name: site.brand, item: origin + localePath(locale, "/") },
			{ "@type": "ListItem", position: 2, name: site.navCategories, item: origin + localePath(locale, "/categories/") },
		],
	},
];
---

<Base
	locale={locale}
	site={site}
	tools={tools}
	title={site.categoriesPageTitle}
	description={site.categoriesPageDescription}
	path="/categories/"
	jsonLd={jsonLd}
>
	<div class="tool-head" style="padding-top:22px">
		<div class="crumbs">
			<a href={localePath(locale, "/")}><Icon name="home" size={14} /></a>
			<span>/</span><span>{site.navCategories}</span>
		</div>
		<h1>{site.categoriesPageH1}</h1>
		<p class="lead">{site.categoriesPageLead}</p>
	</div>

	<ToolShell locale={locale} site={site} tools={tools} active="categories">
		{groups.map((g) => (
			<section class="cat-block" id={g.category.id}>
				<div class="cat-block-head">
					<h2>{g.category.name}</h2>
					<span class="count">{n(g.tools.length)}</span>
					<a class="btn-link cat-more" href={categoryPath(locale, g.category.id)} style="margin-left:auto">
						{locale === "en" ? "Category page" : "分类页"} →
					</a>
				</div>
				<p class="cat-blurb">{g.category.blurb}</p>
				<ul class="toollist">
					{g.tools.map((t) => (
						<li>
							<a href={toolPath(locale, t)}>
								<span class="tl-ico"><Icon name={toolIcon(t.slug)} size={20} /></span>
								<span class="tl-body">
									<span class="tl-name">{t.nav}</span>
									<span class="tl-desc">{t.blurb}</span>
								</span>
								<span class="tl-go">→</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		))}

		<section class="prose">
			<p>
				{locale === "en"
					? "More categories — developer, text and network utilities — appear here as their first tools ship. The sidebar keeps every category one click away as the list grows."
					: "开发、文本、网络这几个分类会在各自第一个工具上线时出现在这里。工具变多之后，左侧导航保证任何分类都只差一次点击。"}
			</p>
		</section>
	</ToolShell>
</Base>
