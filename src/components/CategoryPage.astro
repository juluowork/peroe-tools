---
import type { CategoryCopy, Locale, SiteCopy, ToolCopy } from "../i18n";
import { categoryPath, localePath, toolPath, toolIcon } from "../i18n";
import Base from "../layouts/Base.astro";
import Icon from "./Icon.astro";
import MoreTools from "./MoreTools.astro";
import ToolShell from "./ToolShell.astro";

interface Props {
	locale: Locale;
	site: SiteCopy;
	tools: ToolCopy[];
	category: CategoryCopy;
}
const { locale, site, tools, category } = Astro.props;
const path = `/${category.id}/`;
const inCategory = tools.filter((t) => t.category === category.id);
const others = tools.filter((t) => t.category !== category.id);
const origin = "https://tools.juluo.work";

const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "CollectionPage",
		name: category.metaTitle,
		url: origin + localePath(locale, path),
		description: category.metaDescription,
	},
	{
		"@context": "https://schema.org",
		"@type": "ItemList",
		itemListElement: inCategory.map((t, i) => ({
			"@type": "ListItem",
			position: i + 1,
			name: t.nav,
			url: origin + toolPath(locale, t),
		})),
	},
	{
		"@context": "https://schema.org",
		"@type": "FAQPage",
		mainEntity: category.faq.map((f) => ({
			"@type": "Question",
			name: f.q,
			aacceptedAnswer: { "@type": "Answer", text: f.a },
		})),
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{ "@type": "ListItem", position: 1, name: site.brand, item: origin + localePath(locale, "/") },
			{ "@type": "ListItem", position: 2, name: category.name, item: origin + localePath(locale, path) },
		],
	},
];
---

<Base
	locale={locale}
	site={site}
	tools={tools}
	title={category.metaTitle}
	description={category.metaDescription}
	path={path}
	jsonLd={jsonLd}
>
	<div class="tool-head">
		<div class="crumbs">
			<a href={localePath(locale, "/")}><Icon name="home" size={14} /></a>
			<span>/</span>
			<a href={localePath(locale, "/tools/")}>{site.navAllTools}</a>
			<span>/</span>
			<span>{category.name}</span>
		</div>
		<h1>{category.h1}</h1>
		<p class="lead">{category.blurb}</p>
		<span class="pill"><Icon name="lock" size={14} /> {site.footerNote}</span>
	</div>

	<section class="prose">
		{category.intro.map((p) => <p>{p}</p>)}
	</section>

	<ToolShell locale={locale} site={site} tools={tools} active={category.id}>
		<section>
			<div class="cat-block-head">
				<h2>{category.name}</h2>
				<span class="count">{inCategory.length} {locale === "en" ? "tools" : "个工具"}</span>
			</div>
			<ul class="toollist" style="margin-top:14px">
				{inCategory.map((t) => (
					<li>
						<a href={toolPath(locale, t)}>
							<span class="tl-ico"><Icon name={toolIcon(t.slug)} size={20} /></span>
							<span class="tl-body">
								<span class="tl-name">{t.nav}</span>
								<span class="tl-desc">{t.blurb}</span>
							</span>
							<span class="tl-go">→</span>
						</a>
					</li>
				))}
			</ul>
		</section>
	</ToolShell>

	<div class="ad-slot" data-ad-slot="category-mid"></div>

	<section>
		<h2>{site.faqTitle}</h2>
		{category.faq.map((f) => (
			<details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>
		))}
	</section>

	<MoreTools locale={locale} tools={others} />
</Base>
